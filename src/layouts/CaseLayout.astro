---
// CaseLayout.astro - Layout for individual case study pages
import BaseLayout from './BaseLayout.astro';
import CaseNavigation from '@/components/CaseNavigation.astro';
import CaseSummary from '@/components/CaseSummary.astro';
import StatusEvidence from '@/components/StatusEvidence.astro';
import MediaLightbox from '@/components/MediaLightbox.astro';
import CaseViewToggle from '@/components/CaseViewToggle.astro';
import { ui, statusLabel, type Locale } from '@/i18n';
import { caseUrl, projectsIndexUrl, verifiedOnly } from '@/lib/projects';
import type { ProjectMetric } from '@/content/config';

interface Props {
  title: string;
  /** Case hero headline (localized in the content file) */
  tagline?: string;
  /** Case hero paragraph (localized in the content file) */
  summary?: string;
  /** Meta description fallback */
  description: string;
  seoTitle?: string;
  seoDescription?: string;
  /** Per-case Open Graph image path (falls back to the site default) */
  ogImage?: string;
  year: number;
  role: string;
  productType?: string;
  focus?: string;
  /** Free-form stage label (overrides the localized status row when present) */
  stage?: string;
  /** Optional note rendered under the stage */
  stageNote?: string;
  caseSummary?: { problem: string; role: string; result: string; keyDecision: string };
  statusEvidence?: { stage: string; evidence: string; nextValidation?: string };
  statusBadge?: string;
  /** Upstream/open-source attribution link for the "Base" row */
  openSourceUrl?: string;
  openSourceLabel?: string;
  status: string;
  tags: string[];
  technologies: string[];
  snapshot?: { primary: ProjectMetric[]; secondary: ProjectMetric[] };
  scaleMetrics?: ProjectMetric[];
  productMetrics?: ProjectMetric[];
  cover?: string;
  /** Small square logo shown in the case hero alongside the title */
  logo?: string;
  /** CSS object-position for the logo (e.g. 'center', 'top left') */
  logoPosition?: string;
  /** External product URL â€” renders a discrete CTA link near the hero */
  externalUrl?: string;
  /** Localized label for the external CTA */
  externalUrlLabel?: string;
  /**
   * Controls how the snapshot section is rendered.
   * 'default'           â†’ original layout (no sub-headings)
   * 'product-technical' â†’ opt-in split: Product + Technical Scale headings
   * Other cases that do not set this field continue to render exactly as before.
   */
  snapshotMode?: 'default' | 'product-technical';
  /** Project key (same URL slug across locales) */
  slug: string;
  locale?: Locale;
  /** Opt-in dual-view toggle (Resumo / Case completo) */
  views?: boolean;
  /** Manual reading time overrides for the view toggle (minutes) */
  readingTime?: { basic?: number; full?: number };
}

const {
  title,
  tagline,
  summary,
  description,
  seoTitle,
  seoDescription,
  ogImage,
  year,
  role,
  productType,
  focus,
  stage,
  stageNote,
  caseSummary,
  statusEvidence,
  statusBadge,
  openSourceUrl,
  openSourceLabel,
  status,
  tags = [],
  technologies = [],
  snapshot,
  scaleMetrics = [],
  productMetrics = [],
  cover,
  logo,
  logoPosition,
  externalUrl,
  externalUrlLabel,
  snapshotMode = 'default',
  slug,
  locale = 'pt-BR',
  views = false,
  readingTime,
  ...rest
} = Astro.props;

const caseStudy = ui[locale].caseStudy;

const canonical = caseUrl(locale, slug);
const scale = verifiedOnly(scaleMetrics);
const productImpact = verifiedOnly(productMetrics);
const snapshotPrimary = verifiedOnly(snapshot?.primary);
// When views: true, snapshotSecondary is hidden in "basic" and shown inside FullView in MDX.
// For cases without views, it behaves as before.
const snapshotSecondary = views ? [] : verifiedOnly(snapshot?.secondary);
const hasResults = !views && (scale.length > 0 || productImpact.length > 0);
---

<BaseLayout
  class="proof-page proof-page--case"
  title={title}
  fullTitle={seoTitle}
  description={seoDescription || description}
  ogImage={ogImage}
  canonical={canonical}
  locale={locale}
  {...rest}
>
  <article class="case container">
    <!-- Hero: title and promise on the left, the real product on a dark stage on the right -->
    <header class:list={['case-hero', cover && 'case-hero--with-cover']}>
      <div class="case-hero__copy">
        <div class="case-hero__titlerow">
          {logo && (
            <div class="case-hero__logo" aria-hidden="true">
              <img
                src={logo}
                alt=""
                width="256"
                height="256"
                style={logoPosition ? `object-position: ${logoPosition}` : undefined}
                loading="eager"
                draggable="false"
              />
            </div>
          )}
          <h1 class="case-hero__title">{title}</h1>
        </div>

        {tagline && <p class="case-hero__tagline">{tagline}</p>}
        {summary && <p class="case-hero__summary">{summary}</p>}

        {(externalUrl || views) && (
          <div class="case-hero__actions">
            {externalUrl && (
              <a href={externalUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
                {externalUrlLabel ?? caseStudy.visitProduct}
              </a>
            )}
            {views && (
              <CaseViewToggle
                locale={locale}
                basicMinutes={readingTime?.basic}
                fullMinutes={readingTime?.full}
              />
            )}
          </div>
        )}
      </div>

      {cover && (
        <div class="case-hero__stage field-ink">
          <img src={cover} alt="" width="1600" height="1000" loading="eager" fetchpriority="high" decoding="async" />
        </div>
      )}
    </header>

    <!-- Facts about the work: one quiet row instead of a boxed form -->
    <dl class="case-meta">
      <div>
        <dt>{caseStudy.year}</dt>
        <dd><time datetime={year.toString()}>{year}</time></dd>
      </div>
      {role !== 'needs_confirmation' && (
        <div>
          <dt>{caseStudy.role}</dt>
          <dd>{role}</dd>
        </div>
      )}
      <div>
        <dt>{stage ? caseStudy.stage : caseStudy.status}</dt>
        <dd>{statusBadge ?? stage ?? statusLabel(locale, status)}</dd>
        {stageNote && <dd class="case-meta__note">{stageNote}</dd>}
      </div>
      {productType && (
        <div>
          <dt>{caseStudy.product}</dt>
          <dd>{productType}</dd>
        </div>
      )}
      {openSourceUrl && (
        <div>
          <dt>{caseStudy.base}</dt>
          <dd>
            <a href={openSourceUrl} class="link-underline" target="_blank" rel="noopener noreferrer">
              {openSourceLabel ?? openSourceUrl}
            </a>
          </dd>
        </div>
      )}
      {focus && (
        <div>
          <dt>{caseStudy.focus}</dt>
          <dd>{focus}</dd>
        </div>
      )}
    </dl>

    {caseSummary && <CaseSummary locale={locale} {...caseSummary} />}
    {statusEvidence && <StatusEvidence locale={locale} {...statusEvidence} />}

    <!-- Technical scope snapshot (verified numbers only) -->
    {(snapshotPrimary.length > 0 || snapshotSecondary.length > 0) && (
      <section class="case-snapshot" aria-labelledby="snapshot-heading" data-reveal>
        <h2 id="snapshot-heading" class="case-snapshot__title">{caseStudy.snapshotLabel}</h2>

        {snapshotPrimary.length > 0 && (
          <div>
            {snapshotMode === 'product-technical' && (
              <h3 class="case-snapshot__sub">{caseStudy.snapshotProductLabel}</h3>
            )}
            <ul class="case-figures" role="list">
              {snapshotPrimary.map((metric) => (
                <li>
                  <strong>{metric.value}</strong>
                  <span>{metric.label}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {snapshotSecondary.length > 0 && (
          <div>
            {snapshotMode === 'product-technical' && (
              <h3 class="case-snapshot__sub">{caseStudy.snapshotTechnicalLabel}</h3>
            )}
            <ul class="case-figures case-figures--small" role="list">
              {snapshotSecondary.map((metric) => (
                <li>
                  <strong>{metric.value}</strong>
                  <span>{metric.label}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}

    <!-- Back to projects -->
    <div class="case-back">
      <a href={projectsIndexUrl(locale)} class="back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
        {caseStudy.backToProjects}
      </a>
    </div>

    <!-- Content -->
    <div class="case-body">
      <div class="prose">
        <slot />
      </div>

      <aside class="case-aside">
        <div class="case-aside__sticky">
          {technologies.length > 0 && (
            <div>
              <h2 class="case-aside__title">{caseStudy.stack}</h2>
              <ul class="case-stack" role="list">
                {technologies.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
            </div>
          )}
          {tags.length > 0 && (
            <div>
              <h2 class="case-aside__title">{locale === 'pt-BR' ? 'Temas' : 'Topics'}</h2>
              <ul class="case-stack" role="list">
                {tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </aside>
    </div>

    <!-- Verified results: technical scale + product impact (never empty blocks) -->
    {hasResults && (
      <section class="case-snapshot case-snapshot--results" aria-labelledby="results-heading" data-reveal>
        <h2 id="results-heading" class="case-snapshot__title">{caseStudy.verifiedResults}</h2>

        {scale.length > 0 && (
          <div>
            <h3 class="case-snapshot__sub">{caseStudy.technicalScale}</h3>
            <ul class="case-figures" role="list">
              {scale.map((metric) => (
                <li>
                  <strong>{metric.value}</strong>
                  <span>{metric.label}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {productImpact.length > 0 && (
          <div>
            <h3 class="case-snapshot__sub">{caseStudy.productImpact}</h3>
            <ul class="case-figures" role="list">
              {productImpact.map((metric) => (
                <li>
                  <strong>{metric.value}</strong>
                  <span>{metric.label}</span>
                  {metric.context && <em>{metric.context}</em>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}

    <!-- Navigation -->
    <div class="case-nav">
      <CaseNavigation currentSlug={slug} locale={locale} />
    </div>
  </article>
</BaseLayout>

<MediaLightbox />
