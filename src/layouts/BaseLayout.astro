---
// BaseLayout.astro - Base layout for all pages
import type { AstroProps } from 'astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';
import { siteConfig } from '@/data/profile';
import { generateAlternateLinks, type Locale } from '@/i18n';

interface Props extends AstroProps {
  title: string;
  /** Complete <title> override (used for per-case SEO titles) */
  fullTitle?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noIndex?: boolean;
  class?: string;
  locale?: Locale;
}

const {
  title,
  fullTitle,
  description,
  ogImage,
  canonical,
  noIndex = false,
  class: className = '',
  locale = 'pt-BR',
  ...rest
} = Astro.props;

const siteUrl = siteConfig.url;
const pageUrl = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`;
const pageTitle = fullTitle || (title ? `${title} — Lucas Sehnem` : siteConfig.title);
const pageDescription = description || siteConfig.description;
const pageOgImage = ogImage || siteConfig.ogImage;

// Generate alternate links for SEO
const alternateLinks = canonical ? generateAlternateLinks(canonical, siteUrl) : '';
---

<!doctype html>
<html lang={locale} class="h-full" {...rest}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      (function () {
        var storageKey = 'portfolio-theme';
        var storedTheme = null;

        try {
          storedTheme = window.localStorage.getItem(storageKey);
        } catch (_) {
          // Storage can be unavailable in private or restricted contexts.
        }

        var theme = storedTheme === 'light' || storedTheme === 'dark'
          ? storedTheme
          : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={pageUrl} />

    <!-- Hreflang / Alternate links -->
    {alternateLinks && <Fragment set:html={alternateLinks} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={`${siteUrl}${pageOgImage}`} />
    <meta property="og:site_name" content="Lucas Sehnem" />
    <meta property="og:locale" content={locale} />
    {locale === 'en' && <meta property="og:locale:alternate" content="pt-BR" />}
    {locale === 'pt-BR' && <meta property="og:locale:alternate" content="en" />}

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}${pageOgImage}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'" />

    <!-- View Transitions -->
    <meta name="view-transition" content="same-origin" />
  </head>
  <body class={`min-h-screen text-foreground antialiased ${className}`}>
    <div id="bg-canvas" aria-hidden="true"></div>
    <div class="relative z-10 flex min-h-screen flex-col">
    <a href="#main" class="skip-link">{locale === 'pt-BR' ? 'Pular para o conteúdo principal' : 'Skip to main content'}</a>

    <Header locale={locale} />

    <main id="main" class="flex-1 pt-16 lg:pt-20" role="main">
      <slot />
    </main>

    <Footer locale={locale} />

    <!-- View Transitions script -->
    <script is:inline>
      // View Transitions API polyfill for browsers that don't support it
      if (!document.startViewTransition) {
        const style = document.createElement('style');
        style.textContent = `
          ::view-transition-old(root),
          ::view-transition-new(root) {
            animation-duration: 250ms;
            animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
          }
        `;
        document.head.appendChild(style);
      }
    </script>

    <!-- Scroll reveal animations -->
    <script is:inline>
      (function () {
        // Respect reduced motion preference
        var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (prefersReduced) return;

        var style = document.createElement('style');
        style.textContent = [
          '[data-reveal] {',
          '  opacity: 0;',
          '  transform: translateY(24px);',
          '  transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);',
          '}',
          '[data-reveal].is-visible {',
          '  opacity: 1;',
          '  transform: translateY(0);',
          '}',
          '[data-reveal="scale"] {',
          '  transform: scale(0.97) translateY(16px);',
          '}',
          '[data-reveal="scale"].is-visible {',
          '  transform: scale(1) translateY(0);',
          '}',
          '[data-reveal="left"] {',
          '  transform: translateX(-24px);',
          '}',
          '[data-reveal="left"].is-visible {',
          '  transform: translateX(0);',
          '}',
          '[data-reveal="right"] {',
          '  transform: translateX(24px);',
          '}',
          '[data-reveal="right"].is-visible {',
          '  transform: translateX(0);',
          '}',
        ].join('\n');
        document.head.appendChild(style);

        function initObserver() {
          var elements = document.querySelectorAll('[data-reveal]');
          if (!elements.length) return;

          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  var el = entry.target;
                  var delay = el.getAttribute('data-reveal-delay') || '0';
                  setTimeout(function () {
                    el.classList.add('is-visible');
                  }, parseInt(delay, 10));
                  observer.unobserve(el);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
          );

          elements.forEach(function (el) {
            observer.observe(el);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initObserver);
        } else {
          initObserver();
        }

        // Re-run after view transitions
        document.addEventListener('astro:page-load', initObserver);
      })();
    </script>
    </div>
  </body>
</html>
