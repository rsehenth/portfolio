---
// CaseViewToggle.astro — Seletor segmentado "Resumo / Case completo".
// Renderizado inline ao lado do botão "Acessar produto" no hero.
import { ui, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  basicMinutes?: number;
  fullMinutes?: number;
}

const { locale, basicMinutes, fullMinutes } = Astro.props;
const t = ui[locale].caseViewToggle;

const basicLabel  = basicMinutes  ? `${t.basic} · ${basicMinutes} ${t.minuteSuffix}`  : t.basic;
const fullLabel   = fullMinutes   ? `${t.full} · ${fullMinutes} ${t.minuteSuffix}`    : t.full;
---

<div class="case-view-toggle" data-case-view-toggle>
  {/* Aria-live region — anuncia mudança de visão a leitores de tela */}
  <span
    id="case-view-live"
    role="region"
    aria-live="polite"
    aria-atomic="true"
    data-announce-basic={t.announcingBasic}
    data-announce-full={t.announcingFull}
    class="sr-only"
  ></span>

  <div
    role="group"
    aria-label={t.groupLabel}
    class="cvt-group"
  >
    <button type="button" data-view-btn="basic" aria-pressed="true"  class="cvt-btn" id="cvt-btn-basic">{basicLabel}</button>
    <button type="button" data-view-btn="full"  aria-pressed="false" class="cvt-btn" id="cvt-btn-full">{fullLabel}</button>
  </div>
</div>

<style>
  /* Hide when JS is absent */
  html:not(.js) .case-view-toggle { display: none; }

  .case-view-toggle {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
  }

  .cvt-group {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem;
    background: rgb(var(--color-muted-rgb));
  }

  .cvt-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    cursor: pointer;
    border: none;
    background: transparent;
    color: rgb(var(--color-muted-foreground-rgb));
    transition: background-color 180ms ease, color 180ms ease;
  }

  .cvt-btn:hover { color: rgb(var(--color-foreground-rgb)); }

  .cvt-btn[aria-pressed="true"] {
    background: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
  }

  .cvt-btn:focus-visible {
    outline: 2px solid rgb(var(--color-accent-rgb));
    outline-offset: 2px;
  }

  @media (pointer: coarse) {
    .cvt-btn { min-height: 2.75rem; }
  }

  @media (max-width: 420px) {
    .case-view-toggle,
    .cvt-group {
      width: 100%;
    }

    .cvt-btn {
      min-width: 0;
      flex: 1 1 0;
      padding-inline: 0.5rem;
      text-align: center;
      white-space: normal;
    }
  }
</style>

<script>
  (function () {
    const toggle = document.querySelector<HTMLElement>('[data-case-view-toggle]');
    if (!toggle) return;

    const buttons = Array.from(toggle.querySelectorAll<HTMLElement>('[data-view-btn]'));
    const liveRegion = document.getElementById('case-view-live') as HTMLElement | null;

    function setView(view: 'basic' | 'full', persist = true) {
      document.documentElement.setAttribute('data-case-view', view);

      if (persist) {
        // Persist via ?v= in the URL only (replaceState keeps the chosen view on
        // reload without leaking the preference to other project pages).
        try {
          const url = new URL(window.location.href);
          url.searchParams.set('v', view);
          history.replaceState(null, '', url.toString());
        } catch (_) { /* noop */ }
      }

      buttons.forEach((btn) => {
        btn.setAttribute('aria-pressed', btn.dataset.viewBtn === view ? 'true' : 'false');
      });

      if (liveRegion) {
        liveRegion.textContent = '';
        setTimeout(() => {
          liveRegion.textContent = view === 'basic'
            ? (liveRegion.dataset.announceBasic ?? '')
            : (liveRegion.dataset.announceFull ?? '');
        }, 50);
      }
    }

    // Sync to state set by inline <head> script
    const current = (document.documentElement.getAttribute('data-case-view') as 'basic' | 'full') ?? 'basic';
    setView(current, false);

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const v = btn.dataset.viewBtn as 'basic' | 'full' | undefined;
        if (v === 'basic' || v === 'full') setView(v, true);
      });
    });
  })();
</script>
