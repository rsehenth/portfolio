---
// CaseCarousel.astro — Multi-slide image carousel for case studies.
// Lightbox is handled globally by MediaLightbox.astro (included in CaseLayout).

interface Slide {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  slides: Slide[];
  caption?: string;
  ratio?: string;
  protected?: boolean;
}

const { slides, caption, ratio, protected: isProtected = false } = Astro.props;
if (!slides || slides.length === 0) throw new Error('CaseCarousel requires at least one slide.');

const first = slides[0];
const aspectRatio = ratio ?? `${first.width} / ${first.height}`;
const uid = `cc-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="not-prose my-8">
  <div
    class:list={['cc-root', { 'cc-root--protected': isProtected }]}
    id={uid}
    data-case-carousel
    data-protected={isProtected ? 'true' : undefined}
  >
    <!-- Track -->
    <div class="cc-track" style={`aspect-ratio: ${aspectRatio};`}>
      {slides.map((slide, i) => (
        <div class="cc-slide" data-slide-index={i}>
          <img
            src={slide.src}
            alt={slide.alt}
            width={slide.width}
            height={slide.height}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            class="cc-img"
            draggable="false"
          />
        </div>
      ))}
    </div>

    {slides.length > 1 && (
      <>
        <button type="button" class="cc-btn cc-btn--prev" data-cc-prev aria-label="Anterior">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>
        <button type="button" class="cc-btn cc-btn--next" data-cc-next aria-label="Próximo">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </button>
        <div class="cc-dots">
          {slides.map((_, i) => (
            <button
              type="button"
              class:list={['cc-dot', { 'cc-dot--active': i === 0 }]}
              data-cc-dot={i}
              aria-label={`Slide ${i + 1}`}
            />
          ))}
        </div>
        <span class="cc-counter" data-cc-counter>1 / {slides.length}</span>
      </>
    )}

    <!-- zoom hint -->
    <span class="cc-zoom" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        <line x1="11" y1="8" x2="11" y2="14"/>
        <line x1="8" y1="11" x2="14" y2="11"/>
      </svg>
    </span>
  </div>

  {caption && (
    <figcaption class="mt-3 text-center text-body-sm text-muted-foreground">
      {caption}
    </figcaption>
  )}
</figure>

<style>
  /* ── Root ── */
  .cc-root {
    position: relative;
    border-radius: 1rem;
    border: 1px solid rgb(var(--color-border-rgb));
    background: rgb(var(--color-muted-rgb));
    overflow: hidden;
    cursor: zoom-in;
    -webkit-touch-callout: none;
    transition: box-shadow 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cc-root:hover {
    box-shadow: 0 8px 32px rgb(var(--color-shadow-rgb) / 0.13),
                0 2px 8px  rgb(var(--color-shadow-rgb) / 0.07);
  }

  /* ── Track ── */
  .cc-track {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  /* ── Slides ── */
  .cc-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 400ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  .cc-slide[data-active] {
    opacity: 1;
    pointer-events: auto;
  }
  /* First slide visible before JS runs */
  .cc-slide[data-slide-index="0"] { opacity: 1; }

  .cc-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    -webkit-user-drag: none;
    user-select: none;
    pointer-events: none;
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cc-root:hover .cc-slide[data-active] .cc-img { transform: scale(1.02); }

  /* ── Prev/Next ── */
  .cc-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background: rgb(0 0 0 / 0.45);
    border: 1px solid rgb(255 255 255 / 0.15);
    color: #fff;
    cursor: pointer;
    opacity: 0;
    padding: 0;
    appearance: none;
    transition: opacity 220ms ease, background 200ms ease;
  }
  .cc-btn svg { width: 1rem; height: 1rem; }
  .cc-btn--prev { left: 0.75rem; }
  .cc-btn--next { right: 0.75rem; }
  .cc-root:hover .cc-btn { opacity: 1; }
  .cc-btn:hover { background: rgb(0 0 0 / 0.65); }
  .cc-btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; opacity: 1; }

  /* ── Dots ── */
  .cc-dots {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    display: flex;
    gap: 0.375rem;
    padding: 0.3rem 0.6rem;
    border-radius: 9999px;
    background: rgb(0 0 0 / 0.35);
  }
  .cc-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.45);
    border: none;
    padding: 0;
    cursor: pointer;
    appearance: none;
    transition: background 250ms ease, transform 250ms ease;
  }
  .cc-dot--active { background: #fff; transform: scale(1.25); }
  .cc-dot:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

  /* ── Counter ── */
  .cc-counter {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 20;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .cc-root:hover .cc-counter { opacity: 1; }

  /* ── Zoom hint ── */
  .cc-zoom {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    opacity: 0;
    transform: scale(0.8);
    pointer-events: none;
    transition: opacity 300ms ease, transform 300ms ease;
  }
  .cc-zoom svg { width: 1rem; height: 1rem; }
  .cc-root:hover .cc-zoom { opacity: 1; transform: scale(1); }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .cc-slide, .cc-img, .cc-root, .cc-btn, .cc-dot, .cc-zoom, .cc-counter {
      transition: none !important; transform: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    function initCarousel(root) {
      if (root._ccInit) return;
      root._ccInit = true;

      const slides  = Array.from(root.querySelectorAll('.cc-slide'));
      const dots    = Array.from(root.querySelectorAll('[data-cc-dot]'));
      const prevBtn = root.querySelector('[data-cc-prev]');
      const nextBtn = root.querySelector('[data-cc-next]');
      const counter = root.querySelector('[data-cc-counter]');
      const total   = slides.length;
      let cur = 0;

      /* Mark first slide active */
      slides.forEach((s, i) => {
        if (i === 0) { s.setAttribute('data-active', ''); }
        else { s.style.opacity = '0'; s.style.pointerEvents = 'none'; }
      });

      function goTo(idx) {
        const next = (idx + total) % total;
        if (next === cur) return;

        slides[cur].removeAttribute('data-active');
        slides[cur].style.opacity = '0';
        slides[cur].style.pointerEvents = 'none';

        cur = next;

        slides[cur].setAttribute('data-active', '');
        slides[cur].style.opacity = '1';
        slides[cur].style.pointerEvents = 'auto';

        dots.forEach((d, i) => {
          d.classList.toggle('cc-dot--active', i === cur);
        });
        if (counter) counter.textContent = `${cur + 1} / ${total}`;
      }

      if (prevBtn) prevBtn.addEventListener('click', (e) => { e.stopPropagation(); goTo(cur - 1); });
      if (nextBtn) nextBtn.addEventListener('click', (e) => { e.stopPropagation(); goTo(cur + 1); });
      dots.forEach((d) => d.addEventListener('click', (e) => { e.stopPropagation(); goTo(+d.dataset.ccDot); }));

      /* Keyboard */
      root.setAttribute('tabindex', '0');
      root.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft')  { e.preventDefault(); goTo(cur - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); goTo(cur + 1); }
      });

      /* Swipe */
      let tx = null;
      root.addEventListener('touchstart', (e) => { tx = e.touches[0].clientX; }, { passive: true });
      root.addEventListener('touchend',   (e) => {
        if (tx === null) return;
        const dx = e.changedTouches[0].clientX - tx;
        if (Math.abs(dx) > 40) goTo(dx < 0 ? cur + 1 : cur - 1);
        tx = null;
      }, { passive: true });

      /* Click → lightbox */
      root.addEventListener('click', (e) => {
        if (e.target.closest('[data-cc-prev],[data-cc-next],[data-cc-dot]')) return;
        const img = slides[cur] && slides[cur].querySelector('.cc-img');
        if (img && window.openMediaLightbox) {
          window.openMediaLightbox(img.src, img.alt, root);
        }
      });

      /* Context-menu protection */
      if (root.dataset.protected === 'true') {
        root.addEventListener('contextmenu', (e) => e.preventDefault());
      }
    }

    function bindAll() {
      document.querySelectorAll('[data-case-carousel]').forEach(initCarousel);
    }

    document.addEventListener('astro:page-load', bindAll);
    bindAll();
  })();
</script>
