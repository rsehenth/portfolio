---
// FlowDiagram.astro — Reusable vertical flow diagram for case studies.
// Static, responsive, accessible; no JS. Optional failure branch offset.
interface FlowBranch {
  /** Index of the step the branch falls out of (0-based). */
  at: number;
  label: string;
  steps: string[];
}

interface Props {
  steps: string[];
  branch?: FlowBranch;
  label?: string;
  class?: string;
}

const { steps, branch, label, class: className = '' } = Astro.props;
---

<div class={`not-prose my-8 ${className}`} role="group" aria-label={label ?? 'Flow diagram'}>
  <ol class="space-y-0" aria-label={label ?? 'Flow steps'}>
    {steps.map((step, i) => (
      <li>
        <div class="flex items-start gap-3">
          <span
            class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-border bg-muted text-caption font-mono text-muted-foreground"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <div class="min-w-0 flex-1 rounded-xl border border-border bg-card px-4 py-3">
            <span class="block text-body-sm font-medium text-foreground">{step}</span>
          </div>
        </div>

        {/* Failure branch, offset and visually distinct */}
        {branch && branch.at === i && (
          <div class="mt-3 flex items-start gap-3 pl-6 sm:pl-10">
            <span class="mt-3 h-px w-6 shrink-0 border-t border-dashed border-border" aria-hidden="true"></span>
            <div class="min-w-0 flex-1 rounded-xl border border-dashed border-border bg-muted/50 px-4 py-3">
              <span class="mb-1 block text-caption font-medium uppercase tracking-wider text-muted-foreground">
                {branch.label}
              </span>
              {branch.steps.map((s) => (
                <span class="block text-body-sm text-muted-foreground">{s}</span>
              ))}
            </div>
          </div>
        )}

        {i < steps.length - 1 && (
          <div class="flex pl-3.5" aria-hidden="true">
            <svg class="h-6 w-4 text-border" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m0 0l-5-5m5 5l5-5" />
            </svg>
          </div>
        )}
      </li>
    ))}
  </ol>
</div>
