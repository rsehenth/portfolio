---
// CaseMedia.astro — Single image/video for case studies.
// Lightbox is handled globally by MediaLightbox.astro (included in CaseLayout).
type MediaKind = 'image' | 'gif' | 'video';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  kind?: MediaKind;
  caption?: string;
  protected?: boolean;
}

const { src, alt, width, height, kind = 'image', caption, protected: isProtected = false } = Astro.props;
if (!alt.trim()) throw new Error('CaseMedia requires descriptive alt text.');
if (!src.trim()) throw new Error('CaseMedia requires a media source.');
if (!Number.isFinite(width) || width <= 0 || !Number.isFinite(height) || height <= 0) {
  throw new Error('CaseMedia requires positive width and height.');
}
---

<figure class="not-prose my-8">
  {kind === 'video' ? (
    <video
      class="h-auto w-full rounded-2xl border border-border"
      width={width}
      height={height}
      muted loop playsinline controls preload="none"
      data-case-media-video
      aria-label={alt}
    >
      <source src={src} />
    </video>
  ) : (
    <button
      type="button"
      class:list={['cm-wrap', { 'cm-wrap--protected': isProtected }]}
      style={`aspect-ratio: ${width} / ${height};`}
      aria-label={`Ampliar: ${alt}`}
      data-cm-src={src}
      data-cm-alt={alt}
    >
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
        class="cm-img"
        draggable="false"
      />
      <span class="cm-zoom" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          <line x1="11" y1="8" x2="11" y2="14"/>
          <line x1="8" y1="11" x2="14" y2="11"/>
        </svg>
      </span>
    </button>
  )}
  {caption && (
    <figcaption class="mt-3 text-center text-body-sm text-muted-foreground">
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .cm-wrap {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgb(var(--color-border-rgb));
    background-color: rgb(var(--color-muted-rgb));
    cursor: zoom-in;
    padding: 0;
    appearance: none;
    -webkit-appearance: none;
    -webkit-touch-callout: none;
    transition: box-shadow 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cm-wrap:hover,
  .cm-wrap:focus-visible {
    box-shadow: 0 8px 32px rgb(var(--color-shadow-rgb) / 0.14),
                0 2px 8px  rgb(var(--color-shadow-rgb) / 0.07);
    outline: none;
  }

  .cm-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1),
                filter   400ms cubic-bezier(0.16, 1, 0.3, 1);
    -webkit-user-drag: none;
    user-select: none;
    pointer-events: none;
  }
  .cm-wrap:hover .cm-img,
  .cm-wrap:focus-visible .cm-img {
    transform: scale(1.025);
    filter: brightness(1.03);
  }

  .cm-zoom {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 300ms ease, transform 300ms ease;
    pointer-events: none;
  }
  .cm-zoom svg { width: 1rem; height: 1rem; }
  .cm-wrap:hover .cm-zoom,
  .cm-wrap:focus-visible .cm-zoom { opacity: 1; transform: scale(1); }

  @media (prefers-reduced-motion: reduce) {
    .cm-img, .cm-wrap, .cm-zoom { transition: none !important; transform: none !important; }
  }
</style>

<script is:inline>
  (() => {
    function bindCaseMedia() {
      document.querySelectorAll('[data-cm-src]').forEach((btn) => {
        if (btn._cmBound) return;
        btn._cmBound = true;
        btn.addEventListener('click', () => {
          if (window.openMediaLightbox) {
            window.openMediaLightbox(btn.dataset.cmSrc, btn.dataset.cmAlt || '', btn);
          }
        });
        if (btn.classList.contains('cm-wrap--protected')) {
          btn.addEventListener('contextmenu', (e) => e.preventDefault());
        }
      });
    }

    /* Video auto-play */
    const motionPref = window.matchMedia('(prefers-reduced-motion: reduce)');
    const videoObs = new IntersectionObserver((entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        if (isIntersecting && !motionPref.matches) target.play().catch(() => {});
        else target.pause();
      });
    });
    function syncVideos() {
      document.querySelectorAll('[data-case-media-video]').forEach((v) => {
        videoObs.unobserve(v); videoObs.observe(v);
        if (motionPref.matches) v.pause();
      });
    }

    document.addEventListener('astro:page-load', () => { bindCaseMedia(); syncVideos(); });
    bindCaseMedia();
    syncVideos();
  })();
</script>
