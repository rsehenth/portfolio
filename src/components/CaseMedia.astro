---
type MediaKind = 'image' | 'gif' | 'video';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  kind?: MediaKind;
  caption?: string;
}

const { src, alt, width, height, kind = 'image', caption } = Astro.props;
if (!alt.trim()) throw new Error('CaseMedia requires descriptive alt text.');
---

<figure class="not-prose my-8">
  {kind === 'video' ? (
    <video class="h-auto w-full rounded-2xl border border-border" width={width} height={height} muted loop playsinline controls preload="none" data-case-media-video aria-label={alt}>
      <source src={src} />
    </video>
  ) : (
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" class="h-auto w-full rounded-2xl border border-border" />
  )}
  {caption && <figcaption class="mt-3 text-body-sm text-muted-foreground">{caption}</figcaption>}
</figure>

<script is:inline>
  (() => {
    if (document.documentElement.dataset.caseMediaReady) return;
    document.documentElement.dataset.caseMediaReady = 'true';
    const caseMediaMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const caseMediaObserver = new IntersectionObserver((entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        if (isIntersecting && !caseMediaMotion.matches) {
          target.play().catch(() => {});
        } else {
          target.pause();
        }
      });
    });
    function syncCaseMediaVideos() {
      document.querySelectorAll('[data-case-media-video]').forEach((video) => {
        caseMediaObserver.unobserve(video);
        caseMediaObserver.observe(video);
        if (caseMediaMotion.matches) video.pause();
      });
    }
    caseMediaMotion.addEventListener('change', syncCaseMediaVideos);
    document.addEventListener('astro:page-load', syncCaseMediaVideos);
    syncCaseMediaVideos();
  })();
</script>
