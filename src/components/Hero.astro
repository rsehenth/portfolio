---
import { ui, type Locale } from '@/i18n';

interface Props { locale?: Locale; }
const { locale = 'pt-BR' } = Astro.props;
const hero = ui[locale].hero;
const projectsHref = locale === 'pt-BR' ? '/projects/' : '/en/projects/';
const cvHref = locale === 'pt-BR' ? '/lucas-cvpt.pdf' : '/lucas-cven.pdf';
const { main, side } = hero.visual;
---

<section class="home-hero" aria-labelledby="hero-heading">
  <div class="container">
    <h1 id="hero-heading" class="home-hero__title">
      <span class="hero-line"><span>{hero.headlineBefore}</span></span>
      <span class="hero-line"><span>{hero.headlineAccent} {hero.headlineAfter}</span></span>
    </h1>

    <div class="home-hero__lower">
      <div class="home-hero__copy">
        <p class="home-hero__summary">{hero.subheadline}</p>
        {hero.differentiator && <p class="home-hero__differentiator">{hero.differentiator}</p>}
        <div class="home-hero__actions">
          <a href={projectsHref} class="btn-primary">{hero.ctaPrimary}</a>
          <a href={cvHref} download aria-label={hero.ctaCVAriaLabel} class="btn-secondary">{hero.ctaCV}</a>
        </div>

        <dl class="home-stats">
          {hero.stats.map((stat) => <div><dt>{stat.value}</dt><dd>{stat.label}</dd></div>)}
        </dl>
      </div>

      <div class="home-stage" data-hero-stage>
        <div class="home-stage__field field-ink">
          <a class="home-stage__main" href={main.href}>
            <span class="home-stage__caption"><strong>{main.title}</strong> {main.caption}</span>
            <img
              src={main.src}
              alt={main.alt}
              width={main.width}
              height={main.height}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </a>
        </div>
        <a class="home-stage__side" href={side.href}>
          <img
            src={side.src}
            alt={side.alt}
            width={side.width}
            height={side.height}
            loading="lazy"
            decoding="async"
          />
          <span class="home-stage__side-caption"><strong>{side.title}</strong> {side.caption}</span>
        </a>
      </div>
    </div>
  </div>
</section>
