---
// Footer.astro - Site footer: the second dark stage, closing with the name at full width
import { footerLinks, profile } from '@/data/profile';
import { ui, type Locale } from '@/i18n';

interface Props {
  class?: string;
  locale?: Locale;
}

const { class: className = '', locale = 'pt-BR' } = Astro.props;
const currentYear = new Date().getFullYear();
const footer = ui[locale].footer;

const currentPath = Astro.url.pathname;
const pathWithoutLocale = currentPath.startsWith('/en/') ? currentPath.slice(3) : currentPath;
const switchPath = pathWithoutLocale === '/404/' ? '/' : pathWithoutLocale || '/';
const ptUrl = switchPath;
const enUrl = `/en${switchPath}`;

const isPt = locale === 'pt-BR';
const nav = ui[locale].nav;
const navLinks = [
  { label: nav.projects, href: isPt ? '/projects/' : '/en/projects/' },
  { label: nav.about, href: isPt ? '/about/' : '/en/about/' },
  { label: nav.contact, href: isPt ? '/#contact' : '/en/#contact' },
];
---

<footer class={`site-footer field-ink ${className}`} role="contentinfo">
  <div class="container footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={isPt ? '/' : '/en/'} class="footer-brand__name" aria-label={isPt ? `${profile.name} — Ir para a página inicial` : `${profile.name} — Go to the homepage`}>
          {profile.name}
        </a>
        <p class="footer-brand__role">{profile.headline}</p>
      </div>

      <nav class="footer-links" aria-label={isPt ? 'Navegação do rodapé' : 'Footer navigation'}>
        <ul role="list">
          {navLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
          {footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
                {link.external && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17 17 7M8 7h9v9" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer-lang" role="group" aria-label={isPt ? 'Selecionar idioma' : 'Select language'}>
        <a href={ptUrl} class={`lang-option ${isPt ? 'lang-option--active' : ''}`} hreflang="pt-BR" aria-current={isPt ? 'true' : undefined}>PT</a>
        <a href={enUrl} class={`lang-option ${!isPt ? 'lang-option--active' : ''}`} hreflang="en" aria-current={!isPt ? 'true' : undefined}>EN</a>
      </div>
    </div>

    <div class="footer-legal">
      <p>{footer.copyright.replace('{year}', currentYear.toString())}</p>
      <p>{footer.builtBy}</p>
    </div>

    <p class="site-footer__wordmark" aria-hidden="true">{profile.name}</p>
  </div>
</footer>

<style>
  .footer-inner { padding-top: clamp(3.5rem, 6vw, 5rem); }

  .footer-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .footer-grid { grid-template-columns: minmax(0, 1fr) auto auto; gap: 3rem; align-items: center; }
  }

  .footer-brand__name {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: rgb(var(--color-foreground-rgb));
    text-decoration: none;
  }

  .footer-brand__role {
    margin: 0.5rem 0 0;
    color: rgb(var(--color-muted-foreground-rgb));
  }

  .footer-links ul { display: flex; flex-wrap: wrap; gap: 0 1.75rem; margin: 0; padding: 0; list-style: none; }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    color: rgb(var(--color-foreground-rgb));
    font-weight: 700;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .footer-links a:hover { color: rgb(var(--color-accent-rgb)); }
  .footer-links svg { width: 0.9rem; height: 0.9rem; }

  /* Square segmented switch, same language as the case view toggle */
  .footer-lang {
    display: inline-flex;
    padding: 0.25rem;
    background: rgb(var(--color-muted-rgb));
  }

  .lang-option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    min-height: 2.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: rgb(var(--color-muted-foreground-rgb));
    text-decoration: none;
    transition: color 180ms ease, background-color 180ms ease;
  }

  .lang-option:hover { color: rgb(var(--color-foreground-rgb)); }

  .lang-option--active {
    background: rgb(var(--color-foreground-rgb));
    color: rgb(var(--color-background-rgb));
    pointer-events: none;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: 3rem;
    font-size: 0.875rem;
    color: rgb(var(--color-muted-foreground-rgb));
  }

  .footer-legal p { margin: 0; }
</style>
