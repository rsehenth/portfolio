---
// MediaLightbox.astro — Single global lightbox used by CaseMedia and CaseCarousel.
// Include once in CaseLayout. Components open it via window.openMediaLightbox(src, alt).
---

<div
  id="media-lightbox"
  class="mlb"
  role="dialog"
  aria-modal="true"
  aria-label="Visualização ampliada"
  aria-hidden="true"
  tabindex="-1"
>
  <div class="mlb__backdrop" id="mlb-backdrop" aria-hidden="true"></div>
  <div class="mlb__stage">
    <img class="mlb__img" id="mlb-img" src="" alt="" draggable="false" />
  </div>
  <button type="button" class="mlb__close" id="mlb-close" aria-label="Fechar">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
</div>

<style>
  .mlb {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 280ms cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0ms linear 280ms;
  }
  .mlb[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
    transition: opacity 280ms cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0ms linear 0ms;
  }
  .mlb__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.88);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    cursor: zoom-out;
  }
  .mlb__stage {
    position: relative;
    z-index: 1;
    max-width: min(94vw, 1400px);
    max-height: 92vh;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 32px 80px rgb(0 0 0 / 0.6);
    transform: scale(0.92);
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mlb[aria-hidden="false"] .mlb__stage { transform: scale(1); }
  .mlb__img {
    display: block;
    max-width: 100%;
    max-height: 92vh;
    width: auto;
    height: auto;
    border-radius: inherit;
    -webkit-user-drag: none;
    user-select: none;
    pointer-events: none;
  }
  .mlb__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(255 255 255 / 0.18);
    color: #fff;
    cursor: pointer;
    transition: background 200ms ease, transform 200ms ease;
    appearance: none;
    padding: 0;
  }
  .mlb__close:hover  { background: rgb(255 255 255 / 0.24); transform: scale(1.08); }
  .mlb__close:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .mlb__close svg { width: 1.125rem; height: 1.125rem; }

  @media (prefers-reduced-motion: reduce) {
    .mlb, .mlb__stage { transition: none !important; transform: none !important; }
  }
</style>

<script is:inline>
  (() => {
    if (window._mlbReady) return;
    window._mlbReady = true;

    const lb    = document.getElementById('media-lightbox');
    const img   = document.getElementById('mlb-img');
    const close = document.getElementById('mlb-close');
    const back  = document.getElementById('mlb-backdrop');

    function open(src, alt) {
      if (!lb || !img) return;
      img.src = src;
      img.alt = alt || '';
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      lb.focus();
    }

    function closeLb() {
      if (!lb) return;
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => { if (img) img.src = ''; }, 300);
    }

    /* Expose globally so CaseMedia / CaseCarousel can call it.
       Guard: skip if the trigger element lives inside a hidden view wrapper. */
    window.openMediaLightbox = function(src, alt, triggerEl) {
      if (triggerEl) {
        var viewWrapper = triggerEl.closest('[data-view]');
        if (viewWrapper && getComputedStyle(viewWrapper).display === 'none') return;
      }
      open(src, alt);
    };
    window.closeMediaLightbox = closeLb;

    close && close.addEventListener('click', closeLb);
    back  && back.addEventListener('click', closeLb);

    document.addEventListener('keydown', (e) => {
      if (!lb || lb.getAttribute('aria-hidden') === 'true') return;
      if (e.key === 'Escape') { e.preventDefault(); closeLb(); }
    });
  })();
</script>
