---
// MediaLightbox.astro — Single global lightbox used by CaseMedia and CaseCarousel.
// Include once in CaseLayout. Components open it via window.openMediaLightbox(src, alt).
---

<div
  id="media-lightbox"
  class="mlb"
  role="dialog"
  aria-modal="true"
  aria-label="Visualização ampliada"
  aria-hidden="true"
  tabindex="-1"
>
  <div class="mlb__backdrop" id="mlb-backdrop" aria-hidden="true"></div>
  <div class="mlb__stage" id="mlb-stage"></div>
  <button type="button" class="mlb__zoom" id="mlb-zoom" aria-label="Ampliar imagem" aria-pressed="false">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/>
      <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      <line x1="11" y1="8" x2="11" y2="14"/>
      <line x1="8" y1="11" x2="14" y2="11"/>
    </svg>
  </button>
  <button type="button" class="mlb__close" id="mlb-close" aria-label="Fechar">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
</div>

<style>
  .mlb {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: max(1rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-right)) max(1rem, env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left));
    opacity: 0;
    visibility: hidden;
    transition: opacity 280ms cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0ms linear 280ms;
  }
  .mlb[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
    transition: opacity 280ms cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0ms linear 0ms;
  }
  .mlb__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.88);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    cursor: zoom-out;
  }
  .mlb__stage {
    position: relative;
    z-index: 1;
    max-width: min(94vw, 1400px);
    max-height: 92vh;
    border-radius: 0;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    box-shadow: 0 32px 80px rgb(0 0 0 / 0.6);
    transform: scale(0.92);
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mlb[aria-hidden="false"] .mlb__stage { transform: scale(1); }
  :global(.mlb__img) {
    display: block;
    max-width: 100%;
    max-height: 92vh;
    width: auto;
    height: auto;
    border-radius: inherit;
    cursor: zoom-in;
    -webkit-user-drag: none;
    user-select: none;
    pointer-events: none;
  }
  /* Enlarged: the image keeps its natural size and the stage pans/scrolls. */
  .mlb__stage.is-zoomed :global(.mlb__img) {
    max-width: none;
    max-height: none;
    cursor: zoom-out;
  }
  .mlb__zoom,
  .mlb__close {
    position: absolute;
    top: max(1rem, env(safe-area-inset-top));
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    background: rgb(0 0 0 / 0.55);
    border: 1px solid rgb(255 255 255 / 0.22);
    color: #fff;
    cursor: pointer;
    transition: background 200ms ease, transform 200ms ease;
    appearance: none;
    padding: 0;
  }
  .mlb__close { right: max(1rem, env(safe-area-inset-right)); }
  .mlb__zoom  { right: calc(max(1rem, env(safe-area-inset-right)) + 3.5rem); }
  .mlb__zoom:hover,
  .mlb__close:hover  { background: rgb(0 0 0 / 0.72); transform: scale(1.08); }
  .mlb__zoom:focus-visible,
  .mlb__close:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .mlb__zoom svg,
  .mlb__close svg { width: 1.125rem; height: 1.125rem; }

  @media (prefers-reduced-motion: reduce) {
    .mlb, .mlb__stage { transition: none !important; transform: none !important; }
  }
</style>

<script is:inline>
  (() => {
    if (window._mlbReady) return;
    window._mlbReady = true;

    const lb    = document.getElementById('media-lightbox');
    const stage = document.getElementById('mlb-stage');
    const close = document.getElementById('mlb-close');
    const zoomBtn = document.getElementById('mlb-zoom');
    const back  = document.getElementById('mlb-backdrop');
    let img = null;
    let zoomed = false;
    let lastTrigger = null;

    const isEn = document.documentElement.lang.toLowerCase().startsWith('en');
    const zoomLabelIn = isEn ? 'Zoom in' : 'Ampliar imagem';
    const zoomLabelOut = isEn ? 'Zoom out' : 'Reduzir imagem';

    function setZoom(on) {
      zoomed = on;
      stage?.classList.toggle('is-zoomed', on);
      if (zoomBtn) {
        zoomBtn.setAttribute('aria-pressed', String(on));
        zoomBtn.setAttribute('aria-label', on ? zoomLabelOut : zoomLabelIn);
      }
    }

    function getImage() {
      if (!img && stage) {
        img = document.createElement('img');
        img.className = 'mlb__img';
        img.draggable = false;
        stage.appendChild(img);
      }
      return img;
    }

    function open(src, alt, triggerEl) {
      if (!lb || !src) return;
      const media = getImage();
      if (!media) return;
      lastTrigger = triggerEl || null;
      setZoom(false);
      media.src = src;
      media.alt = alt || '';
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      lb.focus();
    }

    function closeLb() {
      if (!lb) return;
      if (lastTrigger && document.contains(lastTrigger)) lastTrigger.focus();
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setZoom(false);
      setTimeout(() => { if (img) img.removeAttribute('src'); }, 300);
    }

    /* Expose globally so CaseMedia / CaseCarousel can call it.
       Guard: skip if the trigger element lives inside a hidden view wrapper. */
    window.openMediaLightbox = function(src, alt, triggerEl) {
      if (triggerEl) {
        var viewWrapper = triggerEl.closest('[data-view]');
        if (viewWrapper && getComputedStyle(viewWrapper).display === 'none') return;
      }
      open(src, alt, triggerEl);
    };
    window.closeMediaLightbox = closeLb;

    close && close.addEventListener('click', closeLb);
    back  && back.addEventListener('click', closeLb);
    zoomBtn && zoomBtn.addEventListener('click', () => setZoom(!zoomed));
    // The image has pointer-events: none, so clicks land on the stage.
    stage && stage.addEventListener('click', () => setZoom(!zoomed));

    document.addEventListener('keydown', (e) => {
      if (!lb || lb.getAttribute('aria-hidden') === 'true') return;
      if (e.key === 'Escape') { e.preventDefault(); closeLb(); }
    });
  })();
</script>
