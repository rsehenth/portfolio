---
/**
 * ProjectPlate.astro
 *
 * The 16:10 image slot for a project that has no real screenshot yet. It is an
 * emblem, not a mock-up: one flat mark per project, drawn from what the project
 * does (signals, hand-off, search and highlight, tiles, a mesh), in the page ink
 * plus the project's status tone. It never imitates an interface.
 * Unknown keys fall back to the project's initials.
 */
import type { BadgeTone } from '@/lib/projects';

interface Props {
  projectKey: string;
  title: string;
  tone: BadgeTone;
  class?: string;
}

const { projectKey, title, tone, class: className = '' } = Astro.props;

// Rect: [x, y, w, h, fill]. Fills: i ink · a ink 35% · b ink 12% · t status tone · h tone 40%
type Rect = [number, number, number, number, 'i' | 'a' | 'b' | 't' | 'h'];

interface Mark {
  rects: Rect[];
  /** Thick connectors */
  paths?: string[];
  /** Thin mesh lines */
  lines?: string[];
}

// AI Command Center: a grid of signals with one lit path ending on the focus cell.
const signalGrid = (): Rect[] => {
  const lit = new Set(['0,2', '1,2', '1,1', '2,1', '3,1', '3,0', '4,0']);
  const out: Rect[] = [];
  for (let j = 0; j < 3; j++) {
    for (let i = 0; i < 6; i++) {
      const id = `${i},${j}`;
      const fill = i === 5 && j === 0 ? 't' : lit.has(id) ? 'i' : 'b';
      out.push([20 + i * 21, 22 + j * 21, 14, 14, fill]);
    }
  }
  return out;
};

// Cripto Host: a mesh of peers around one node, no single centre of the picture.
const peers: Array<[number, number]> = [[28, 30], [70, 16], [122, 26], [132, 66], [84, 80], [34, 68]];
const mesh = (): Mark => ({
  lines: [
    ...peers.map(([x, y]) => `M80 50L${x} ${y}`),
    ...peers.map(([x, y], i) => {
      const [nx, ny] = peers[(i + 1) % peers.length];
      return `M${x} ${y}L${nx} ${ny}`;
    }),
  ],
  rects: [
    ...peers.map(([x, y]): Rect => [x - 6, y - 6, 12, 12, 'i']),
    [72, 42, 16, 16, 't'],
  ],
});

const marks: Record<string, Mark> = {
  'ai-command-center': { rects: signalGrid() },
  // Project Relay: three hand-offs climbing, the baton (tone) in the middle.
  'project-relay': {
    rects: [[26, 58, 20, 20, 'i'], [70, 40, 20, 20, 't'], [114, 22, 20, 20, 'i']],
    paths: ['M46 68H58V50H70', 'M90 50H102V32H114'],
  },
  // Universal Technical Docs: a page with a highlighted search hit.
  'universal-docs': {
    rects: [
      [38, 22, 52, 8, 'i'],
      [50, 45, 34, 11, 'h'],
      [38, 38, 84, 4, 'a'],
      [38, 48, 68, 4, 'a'],
      [38, 58, 78, 4, 'a'],
      [38, 68, 46, 4, 'a'],
    ],
  },
  // Mosaic: blocks of different sizes that tile a page.
  mosaic: {
    rects: [
      [30, 20, 44, 28, 'i'], [78, 20, 26, 28, 't'], [108, 20, 22, 13, 'a'], [108, 37, 22, 11, 'i'],
      [30, 52, 28, 28, 'a'], [62, 52, 42, 28, 'i'], [108, 52, 22, 28, 'a'],
    ],
  },
  'cripto-host-decentralized-hosting': mesh(),
};

const mark = marks[projectKey];
const words = title.trim().split(/\s+/);
const initials = (words.length > 1 ? words.slice(0, 2).map((w) => w[0]) : [words[0]?.[0] ?? ''])
  .join('')
  .toUpperCase();
---

<div class={`plate ${className}`} style={`--tone: var(--tone-${tone})`} aria-hidden="true">
  {mark ? (
    <svg viewBox="0 0 160 100" preserveAspectRatio="xMidYMid slice" focusable="false">
      {mark.lines?.map((d) => <path class="thin" d={d} />)}
      {mark.paths?.map((d) => <path class="thick" d={d} />)}
      {mark.rects.map(([x, y, w, h, f]) => <rect class={`f-${f}`} x={x} y={y} width={w} height={h} />)}
    </svg>
  ) : (
    <span class="plate__initials">{initials}</span>
  )}
</div>

<style>
  .plate {
    display: block;
    width: 100%;
    height: 100%;
    background: color-mix(in srgb, var(--tone) 15%, rgb(var(--color-background-rgb)));
  }

  .plate svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .f-i { fill: rgb(var(--color-foreground-rgb)); }
  .f-a { fill: rgb(var(--color-foreground-rgb) / 0.35); }
  .f-b { fill: rgb(var(--color-foreground-rgb) / 0.12); }
  .f-t { fill: var(--tone); }
  .f-h { fill: color-mix(in srgb, var(--tone) 45%, transparent); }

  .thin { fill: none; stroke: rgb(var(--color-foreground-rgb) / 0.35); stroke-width: 1.25; }
  .thick { fill: none; stroke: rgb(var(--color-foreground-rgb)); stroke-width: 3; }

  .plate__initials {
    display: grid;
    height: 100%;
    place-items: center;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }
</style>
