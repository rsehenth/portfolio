---
// ProjectsIndex.astro - /projects listing (PT + EN).
// Section membership comes from each project's frontmatter `section` field;
// only the localized titles/subtitles live here in i18n.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { ui, type Locale } from '@/i18n';
import { getPublishedProjects, type ProjectEntry } from '@/lib/projects';

interface Props {
  locale?: Locale;
}

const { locale = 'pt-BR' } = Astro.props;
const projects = await getPublishedProjects(locale);
const page = ui[locale].projectsPage;

type SectionId = (typeof page.sections)[number]['id'];
type CardVariant = 'default' | 'featured' | 'compact';

/** Card variant follows the section — never hardcoded per project. */
function variantFor(id: SectionId): CardVariant {
  if (id === 'featured') return 'featured';
  if (id === 'archived') return 'compact';
  return 'default';
}

/**
 * Column count = number of items in the section (max 3), so a section never
 * leaves an orphan card or a half-empty row.
 *   2 items → 1 col below 768px, 2 cols from 768px
 *   3 items → 1 col below 1024px, 3 cols from 1024px
 */
function gridClass(count: number): string {
  if (count >= 3) return 'grid grid-cols-1 gap-5 lg:grid-cols-3 lg:gap-6';
  if (count === 2) return 'grid grid-cols-1 gap-5 md:grid-cols-2 lg:gap-6';
  return 'grid grid-cols-1 gap-5 lg:gap-6';
}

type SectionView = {
  id: SectionId;
  title: string;
  subtitle: string;
  variant: CardVariant;
  entries: ProjectEntry[];
};

const sections: SectionView[] = page.sections
  .map((section) => ({
    id: section.id,
    title: section.title,
    subtitle: section.subtitle,
    variant: variantFor(section.id),
    entries: projects.filter((project) => project.data.section === section.id),
  }))
  .filter((section) => section.entries.length > 0);
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonical={locale === 'pt-BR' ? '/projects/' : '/en/projects/'}
  locale={locale}
>
  <div class="pb-20 pt-24 lg:pb-28 lg:pt-28">
    <div class="container">
      <header class="mb-14 lg:mb-16" data-reveal>
        <h1 class="mb-3 text-display-xl font-bold tracking-tight text-foreground lg:text-display-lg">{page.title}</h1>
        <p class="max-w-2xl text-body-lg text-muted-foreground">{page.subtitle}</p>
      </header>

      {
        sections.length === 0 ? (
          <p class="text-body-md text-muted-foreground">{page.empty}</p>
        ) : (
          sections.map((section, index) => (
            <section
              aria-labelledby={`${section.id}-heading`}
              class:list={['projects-section', index === 0 && 'projects-section--first']}
            >
              <header class="projects-section__header">
                <div class="projects-section__title-row">
                  <h2 id={`${section.id}-heading`} class="projects-section__title">
                    {section.title}
                  </h2>
                  <span class="projects-section__count" aria-hidden="true">
                    {section.entries.length}
                  </span>
                </div>
                <p class="projects-section__subtitle">{section.subtitle}</p>
              </header>

              {section.variant === 'compact' ? (
                <div class="projects-section__list">
                  {section.entries.map((project, itemIndex) => (
                    <div data-reveal data-reveal-delay={String((itemIndex % 3) * 60)}>
                      <ProjectCard project={project} locale={locale} variant="compact" headingLevel={3} />
                    </div>
                  ))}
                </div>
              ) : (
                <div class={gridClass(section.entries.length)}>
                  {section.entries.map((project, itemIndex) => (
                    <div data-reveal data-reveal-delay={String((itemIndex % 3) * 60)}>
                      <ProjectCard project={project} locale={locale} variant={section.variant} headingLevel={3} />
                    </div>
                  ))}
                </div>
              )}
            </section>
          ))
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Section rhythm: rule, spacing, small heading with a counter ── */
  .projects-section {
    margin-top: 4rem; /* 64px — within the 56–72px range */
    padding-top: 1.5rem;
    border-top: 1px solid rgb(var(--color-border-rgb));
  }

  .projects-section--first {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .projects-section__header {
    margin-bottom: 1.5rem; /* 24px before the cards */
  }

  .projects-section__title-row {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
  }

  .projects-section__title {
    font-size: clamp(1.5rem, 2vw, 1.75rem);
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.01em;
    /* No narrow max-width: the heading must not break in two on desktop */
  }

  @media (min-width: 768px) {
    .projects-section__title {
      white-space: nowrap;
    }
  }

  .projects-section__count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    padding: 0.25rem 0.5rem;
    color: rgb(var(--color-muted-foreground-rgb));
    background-color: rgb(var(--color-muted-rgb));
    border: 1px solid rgb(var(--color-border-rgb));
    border-radius: 999px;
  }

  .projects-section__subtitle {
    margin-top: 0.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(var(--color-muted-foreground-rgb));
  }

  @media (min-width: 768px) {
    .projects-section__subtitle {
      white-space: nowrap;
    }
  }

  /* Archived section: compact rows instead of full cards */
  .projects-section__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
</style>
