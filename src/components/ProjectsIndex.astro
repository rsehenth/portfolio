---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { ui, type Locale } from '@/i18n';
import { getPublishedProjects, projectKey, type ProjectEntry } from '@/lib/projects';

interface Props {
  locale?: Locale;
}

const { locale = 'pt-BR' } = Astro.props;
const projects = await getPublishedProjects(locale);
const page = ui[locale].projectsPage;

type ProjectGroup = {
  id: string;
  title: string;
  description: string;
  keys: string[];
};

const groups: ProjectGroup[] = locale === 'pt-BR'
  ? [
      { id: 'active', title: 'Produtos ativos', description: 'Produtos disponíveis ou em uso no fluxo de trabalho.', keys: ['profresolve'] },
      { id: 'development', title: 'Em desenvolvimento', description: 'Produtos e experiências em evolução, com próximas validações definidas.', keys: ['super-squad-ai', 'cultos', 'project-aurora'] },
      { id: 'discovery', title: 'On Hold · Em Discovery', description: 'Projetos com pesquisa inicial concluída e hipótese definida, aguardando alinhamento de validações antes de entrar em desenvolvimento.', keys: ['project-stream', 'project-relay'] },
      { id: 'closed', title: 'Concluídos, encerrados e experimentais', description: 'Projetos concluídos, encerrados ou usados para explorar uma hipótese.', keys: ['cripto-host-decentralized-hosting', 'universal-docs', 'mosaic'] },
    ]
  : [
      { id: 'active', title: 'Active products', description: 'Products available publicly or used in the development workflow.', keys: ['profresolve'] },
      { id: 'development', title: 'In development', description: 'Products and experiences still evolving, with defined next validations.', keys: ['super-squad-ai', 'cultos', 'project-aurora'] },
      { id: 'discovery', title: 'On Hold · Discovery', description: 'Projects with initial research done and hypothesis defined, pending validation alignment before entering development.', keys: ['project-stream'] },
      { id: 'closed', title: 'Completed, closed and experimental', description: 'Projects completed, closed or used to explore a hypothesis.', keys: ['cripto-host-decentralized-hosting', 'universal-docs', 'mosaic'] },
    ];

function projectsForGroup(group: ProjectGroup): ProjectEntry[] {
  return group.keys
    .map((key) => projects.find((project) => projectKey(project) === key))
    .filter((project): project is ProjectEntry => Boolean(project));
}
---

<BaseLayout title={page.title} description={page.description} canonical={locale === 'pt-BR' ? '/projects/' : '/en/projects/'} locale={locale}>
  <div class="pb-20 pt-24 lg:pb-28 lg:pt-28">
    <div class="container">
      <header class="mb-14 lg:mb-16" data-reveal>
        <h1 class="mb-3 text-display-xl font-bold tracking-tight text-foreground lg:text-display-lg">{page.title}</h1>
        <p class="max-w-2xl text-body-lg text-muted-foreground">{page.subtitle}</p>
      </header>

      <div class="space-y-16 lg:space-y-20">
        {groups.map((group) => {
          const entries = projectsForGroup(group);
          return entries.length > 0 && (
            <section aria-labelledby={`${group.id}-heading`}>
              <header class="mb-6 max-w-2xl">
                <h2 id={`${group.id}-heading`} class="text-display-sm font-bold tracking-tight text-foreground">{group.title}</h2>
                <p class="mt-2 text-body-md text-muted-foreground">{group.description}</p>
              </header>
              <div class="grid gap-5 md:grid-cols-2 lg:gap-6">
                {entries.map((project, index) => (
                  <div data-reveal data-reveal-delay={String((index % 2) * 80)}>
                    <ProjectCard project={project} locale={locale} headingLevel={3} />
                  </div>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </div>
</BaseLayout>
