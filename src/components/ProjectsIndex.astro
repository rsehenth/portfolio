---
// ProjectsIndex.astro - /projects listing (PT + EN).
// Section membership comes from each project's frontmatter `section` field;
// only the localized titles/subtitles live here in i18n.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectsSection from '@/components/ProjectsSection.astro';
import { ui, type Locale } from '@/i18n';
import { getPublishedProjects, projectKey, type ProjectEntry } from '@/lib/projects';

interface Props {
  locale?: Locale;
}

const { locale = 'pt-BR' } = Astro.props;
const projects = await getPublishedProjects(locale);
const page = ui[locale].projectsPage;

type SectionId = (typeof page.sections)[number]['id'];
type CardVariant = 'default' | 'featured' | 'compact' | 'wide';

/** Card variant follows the section — never hardcoded per project. */
function variantFor(id: SectionId): CardVariant {
  if (id === 'featured') return 'featured';
  if (id === 'archived') return 'compact';
  return 'default';
}

/** Sections that sit on the soft tonal step; the others alternate with the page ground. */
const SOFT_SECTIONS = new Set<string>(['discovery', 'archived']);

type SectionView = {
  id: SectionId;
  title: string;
  subtitle: string;
  variant: CardVariant;
  entries: ProjectEntry[];
};

const sections: SectionView[] = page.sections
  .map((section) => ({
    id: section.id,
    title: section.title,
    subtitle: section.subtitle,
    variant: variantFor(section.id),
    entries: projects.filter((project) => project.data.section === section.id),
  }))
  .filter((section) => section.entries.length > 0);

// Which cards render as wide rows, and which of those flip (image on the right), so
// consecutive wide rows alternate down the page.
let wideSeen = 0;
const layout: Record<string, { variant: CardVariant; reverse: boolean }> = {};
for (const section of sections) {
  section.entries.forEach((project, index) => {
    const wide = section.variant === 'default' && (section.entries.length === 1 || (section.entries.length === 3 && index === 0));
    layout[projectKey(project)] = {
      variant: wide ? 'wide' : section.variant,
      reverse: wide ? wideSeen++ % 2 === 1 : false,
    };
  });
}

const opensOnStage = sections[0]?.id === 'featured';
const first = opensOnStage ? sections[0] : undefined;
const rest = opensOnStage ? sections.slice(1) : sections;
---

<BaseLayout
  class="proof-page proof-page--projects"
  title={page.title}
  description={page.description}
  canonical={locale === 'pt-BR' ? '/projects/' : '/en/projects/'}
  locale={locale}
>
  <div class="scroll-progress" aria-hidden="true">
    <span class="scroll-progress__fill" data-fx-progress></span>
  </div>

  <!-- The page opens on the dark stage: title first, the featured projects straight under it -->
  <div class:list={['projects-opening', opensOnStage && 'field-ink']}>
    <div class="container projects-head">
      <h1 class="projects-head__title">
        <span class="hero-line"><span>{page.title}</span></span>
      </h1>
      <p class="projects-head__lede">{page.subtitle}</p>
    </div>

    {first && <ProjectsSection {...first} layout={layout} opening locale={locale} />}
  </div>

  {
    sections.length === 0 ? (
      <div class="container">
        <p class="projects-empty">{page.empty}</p>
      </div>
    ) : (
      rest.map((section) => (
        <ProjectsSection {...section} layout={layout} soft={SOFT_SECTIONS.has(section.id)} locale={locale} />
      ))
    )
  }
</BaseLayout>

<style>
  .projects-head {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    padding-block: clamp(3.5rem, 7vw, 6rem) clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 900px) {
    .projects-head { grid-template-columns: minmax(0, 1fr) minmax(0, 26rem); gap: 4rem; }
  }

  .projects-head__title {
    margin: 0;
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .projects-head__lede {
    margin: 0;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.55;
    color: rgb(var(--color-muted-foreground-rgb));
  }

  .projects-empty {
    padding-block: 4rem;
    color: rgb(var(--color-muted-foreground-rgb));
  }
</style>
