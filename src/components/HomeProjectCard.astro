---
/**
 * HomeProjectCard.astro
 *
 * Home-EXCLUSIVE featured case row: a large real image beside the case summary.
 * Uses the homeProjects editorial layer from ui.ts — NOT MDX frontmatter —
 * for every word, and the project's own `cover` for the image.
 * This component must NOT be used in /projects or case pages.
 *
 * Renders: image (cover, 16:10) · title (h3) · category + status · description ·
 * focus line · highlights (value + label) · case link.
 */
import type { Locale } from '@/i18n';

interface HomeHighlight {
  value: string;
  label: string;
}

interface HomeProjectData {
  category: string;
  statusBadge?: string;
  description: string;
  highlights: readonly HomeHighlight[];
  focus: readonly string[];
}

interface Props {
  /** Authoritative project title from MDX data.title */
  title: string;
  /** Localized case URL */
  href: string;
  /** Home editorial data from ui[locale].homeProjects.projects[slug] */
  homeData: HomeProjectData;
  /** CTA label from ui[locale].homeProjects.viewCase */
  viewCaseLabel: string;
  /** Kept for call-site compatibility; every featured row uses the same layout. */
  variant?: 'hero' | 'default';
  locale?: Locale;
  /** data-reveal-delay value in ms (used by scroll-reveal JS) */
  revealDelay?: number;
  /** Project logo path from MDX frontmatter (fallback when there is no cover) */
  logo?: string;
  logoPosition?: string;
  /** Real 16:10 project cover from MDX frontmatter */
  cover?: string;
}

const {
  title,
  href,
  homeData,
  viewCaseLabel,
  locale = 'pt-BR',
  revealDelay = 0,
  logo,
  logoPosition,
  cover,
} = Astro.props;

const titleId = `hpc-${href.replace(/\//g, '-').replace(/^-|-$/g, '')}-title`;
const label = viewCaseLabel.replace(/\s*→\s*$/, '');
---

<article class="case-row group" aria-labelledby={titleId} data-reveal data-reveal-delay={String(revealDelay)}>
  <a class="case-row__media" href={href} tabindex="-1" aria-hidden="true">
    {cover ? (
      <img src={cover} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
    ) : (
      logo && <img class="case-row__logo" src={logo} alt="" width="256" height="256" loading="lazy" decoding="async" style={logoPosition ? `object-position: ${logoPosition}` : undefined} />
    )}
  </a>

  <div class="case-row__text">
    <h3 id={titleId} class="case-row__title">
      <a href={href}>{title}</a>
    </h3>

    <p class="case-row__meta">
      {homeData.category}
      {homeData.statusBadge && <span class="case-row__status">{homeData.statusBadge}</span>}
    </p>

    <p class="case-row__description">{homeData.description}</p>

    {homeData.focus.length > 0 && (
      <p class="case-row__focus" aria-label={locale === 'pt-BR' ? 'Áreas de atuação' : 'Focus areas'}>
        {homeData.focus.slice(0, 3).join(' · ')}
      </p>
    )}

    {homeData.highlights.length > 0 && (
      <dl class="case-row__figures">
        {homeData.highlights.slice(0, 2).map((h) => (
          <div>
            <dt>{h.value}</dt>
            <dd>{h.label}</dd>
          </div>
        ))}
      </dl>
    )}

    <a class="case-row__cta" href={href}>
      {label}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
  </div>
</article>
