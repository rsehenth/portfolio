---
// DataTable.astro - Accessible data table component for MDX
import type { AstroProps } from 'astro';

interface Props extends AstroProps {
  columns: string[];
  rows: (string | number)[][];
  caption?: string;
  striped?: boolean;
  hoverable?: boolean;
  class?: string;
}

const {
  columns,
  rows,
  caption,
  striped = true,
  hoverable = true,
  class: className = '',
} = Astro.props;
---

<div class={`overflow-x-auto ${className}`} role="region" aria-label={caption ? `Data table: ${caption}` : 'Data table'} tabindex="0">
  <table class="w-full border-collapse">
    {caption && (
      <caption class="sr-only">{caption}</caption>
    )}
    <thead>
      <tr class="border-b border-border">
        {columns.map((col, i) => (
          <th
            scope="col"
            class="px-4 py-3 text-left text-caption font-semibold text-muted-foreground uppercase tracking-wider bg-muted/50"
          >
            {col}
          </th>
        ))}
      </tr>
    </thead>
    <tbody class="divide-y divide-border">
      {rows.map((row, rowIndex) => (
        <tr
          class={`${striped && rowIndex % 2 === 1 ? 'bg-muted/30' : ''} ${hoverable ? 'hover:bg-muted/50 transition-colors duration-fast' : ''}`}
        >
          {row.map((cell, cellIndex) => (
            <td
              class="px-4 py-3 text-body-sm text-foreground"
            >
              {cell}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>