---
// HomePage.astro - Shared homepage for both locales (PT-BR / EN)
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import HomeProjectCard from '@/components/HomeProjectCard.astro';
import EmailReveal from '@/components/EmailReveal.astro';
import { profile } from '@/data/profile';
import { ui, type Locale } from '@/i18n';
import { getPublishedProjects, projectKey, caseUrl } from '@/lib/projects';

interface Props {
  locale?: Locale;
}

const { locale = 'pt-BR' } = Astro.props;

const projects = await getPublishedProjects(locale);
const featuredOrder = ['profresolve', 'super-squad-ai', 'clt-simulator'];
const featuredProjects = featuredOrder
  .map((key) => projects.find((project) => projectKey(project) === key))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));

const meta = ui[locale].meta;
const work = ui[locale].work;
const homeEvidence = ui[locale].homeEvidence;
const homeProjectsData = ui[locale].homeProjects;
const howIWork = ui[locale].howIWork;
const howProcess = ui[locale].hero.process;
const projectsHref = locale === 'pt-BR' ? '/projects/' : '/en/projects/';

// "ProfResolve · 15 geradores" → project + fact, so each fact reads as a row.
const facts = homeEvidence.items.map((item) => {
  const [project, ...rest] = item.text.split(' · ');
  const fact = rest.join(' · ');
  return { project, fact: fact.charAt(0).toUpperCase() + fact.slice(1), href: item.href };
});
const about = ui[locale].about;
const contact = ui[locale].contact;

// Pre-resolve home editorial data for featured projects in the frontmatter block
// (avoids TypeScript generic syntax inside JSX template which esbuild cannot parse)
type HomeProjectKey = keyof typeof homeProjectsData.projects;

const featuredCards = featuredProjects.map((project, i) => {
  const key = projectKey(project);
  const href = caseUrl(locale, key);
  const homeData = homeProjectsData.projects[key as HomeProjectKey] ?? null;
  return { project, key, href, homeData, delay: i * 100 };
});

---

<BaseLayout class="proof-page proof-page--home" fullTitle={meta.siteTitle} description={meta.siteDescription} locale={locale}>
  <Hero locale={locale} />

  <!-- Selected Work: a dark stage so the product images carry the page -->
  <section id="work" class="section field-ink work-stage" aria-labelledby="work-heading">
    <div class="container">
      <header class="section-head" data-reveal>
        <div>
          <h2 id="work-heading" class="section-title">{work.title}</h2>
          <p class="section-lede">{homeProjectsData.subtitle}</p>
        </div>
        <a href={projectsHref} class="section-link">
          {homeProjectsData.viewAll.replace(/\s*→\s*$/, '')}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </header>

      {featuredProjects.length > 0 ? (
        <div class="case-rows">
          {featuredCards.map(({ project, href, homeData, delay }) =>
            homeData ? (
              <HomeProjectCard
                title={project.data.title}
                href={href}
                homeData={homeData}
                viewCaseLabel={homeProjectsData.viewCase}
                locale={locale}
                revealDelay={delay}
                logo={project.data.logo}
                logoPosition={project.data.logoPosition}
                cover={project.data.cover}
              />
            ) : null
          )}
        </div>
      ) : (
        <p class="section-lede">{work.empty}</p>
      )}
    </div>
  </section>

  <!-- Verified facts: an index of rows, each linking to its case when there is one -->
  <section class="section home-facts" aria-labelledby="evidence-heading">
    <div class="container home-facts__grid">
      <h2 id="evidence-heading" class="section-title" data-reveal>{homeEvidence.title}</h2>
      <ul role="list" class="fact-list" data-reveal data-reveal-delay="80">
        {facts.map((item) => (
          <li>
            {item.href ? (
              <a href={item.href}>
                <span class="fact-list__text">{item.fact}</span>
                <span class="fact-list__project">{item.project}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
              </a>
            ) : (
              <div>
                <span class="fact-list__text">{item.fact}</span>
                <span class="fact-list__project">{item.project}</span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- How I work: the process as one line, then the three pillars -->
  <section id="how-i-work" class="section home-how" aria-labelledby="how-i-work-heading">
    <div class="container">
      <header class="section-head section-head--stack" data-reveal>
        <h2 id="how-i-work-heading" class="section-title">{howIWork.title}</h2>
        <p class="section-lede">{howIWork.subtitle}</p>
      </header>

      <ol class="home-process" aria-label={howProcess.title}>
        {howProcess.steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>

      <div class="pillars" data-fx-cards>
        {[
          { block: howIWork.product, skills: howIWork.skills.product },
          { block: howIWork.technology, skills: howIWork.skills.technology },
          { block: howIWork.execution, skills: howIWork.skills.execution },
        ].map(({ block, skills }) => (
          <div class="pillar fx-card">
            <h3>{block.title}</h3>
            <p>{block.description}</p>
            <ul role="list">
              {skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About: short; the full story lives on /about -->
  <section id="about" class="section home-about" aria-labelledby="about-heading">
    <div class="container home-about__grid">
      <h2 id="about-heading" class="section-title" data-reveal>{about.title}</h2>
      <div class="home-about__text" data-reveal data-reveal-delay="80">
        <p class="home-about__lead">{about.bio.p1}</p>
        <p>{about.bio.p2}</p>
        <p set:html={about.bio.p3} />
      </div>
    </div>
  </section>

  <!-- Contact: the second dark stage closes the page -->
  <section id="contact" class="section field-ink contact-stage" aria-labelledby="contact-heading">
    <div class="container">
      <div class="contact-stage__inner" data-reveal>
        <h2 id="contact-heading" class="contact-stage__title">{contact.title}</h2>
        <p class="section-lede">{contact.subtitle}</p>
        <div class="contact-stage__actions">
          <a href={profile.linkedin} class="btn-primary" target="_blank" rel="noopener noreferrer">
            {contact.ctaLinkedin}
          </a>
          <EmailReveal
            locale={locale}
            buttonLabel={contact.showEmail}
            revealedLabel={contact.emailRevealedLabel}
            ariaLabel={contact.emailAriaLabel}
          />
          <a
            href={locale === 'pt-BR' ? '/lucas-cvpt.pdf' : '/lucas-cven.pdf'}
            download
            aria-label={locale === 'pt-BR' ? 'Baixar currículo em PDF' : 'Download resume as PDF'}
            class="btn-secondary"
          >
            {contact.ctaCV}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
