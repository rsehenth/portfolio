---
// ComparisonBlock.astro — Editorial two-column comparison for case studies.
// Renders an aligned A → B mapping (arrows) or two independent lists.

interface Props {
  titleA: string;
  titleB: string;
  itemsA?: string[];
  itemsB?: string[];
  /** Draw an arrow between aligned rows (both sides must line up). */
  arrows?: boolean;
  /** Accessible label for the block. */
  label?: string;
  class?: string;
}

const {
  titleA,
  titleB,
  itemsA = [],
  itemsB = [],
  arrows = true,
  label,
  class: className = '',
} = Astro.props;

const rows = Math.max(itemsA.length, itemsB.length);
const aligned = arrows && itemsA.length === itemsB.length;
---

<div
  class={`not-prose my-8 overflow-hidden rounded-2xl border border-border ${className}`}
  role="group"
  aria-label={label ?? `${titleA} vs ${titleB}`}
>
  {aligned ? (
    <div class="divide-y divide-border">
      <!-- Headers: stack on mobile, side-by-side on sm+ -->
      <div class="grid grid-cols-1 bg-muted/60 sm:grid-cols-[1fr_auto_1fr]">
        <div class="px-4 py-3 text-caption font-semibold uppercase tracking-wider text-muted-foreground sm:px-6">
          {titleA}
        </div>
        <div aria-hidden="true" class="hidden sm:block"></div>
        <div class="border-t border-border px-4 py-3 text-caption font-semibold uppercase tracking-wider text-accent sm:border-t-0 sm:px-6">
          {titleB}
        </div>
      </div>

      <!-- Aligned rows: stack on mobile, arrow layout on sm+ -->
      {Array.from({ length: rows }).map((_, i) => (
        <div class="grid grid-cols-1 items-center sm:grid-cols-[1fr_auto_1fr]">
          <div class="px-4 py-3 text-body-sm text-muted-foreground sm:px-6">
            {itemsA[i] ?? ''}
          </div>
          <div class="hidden px-2 text-muted-foreground/60 sm:block" aria-hidden="true">→</div>
          <div class="border-t border-dashed border-border px-4 pb-3 pt-2 text-body-sm font-medium text-foreground sm:border-t-0 sm:px-6 sm:py-3">
            {itemsB[i] ?? ''}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="grid sm:grid-cols-2">
      <div class="border-b border-border sm:border-b-0 sm:border-r">
        <div class="bg-muted/60 px-4 py-3 text-caption font-semibold uppercase tracking-wider text-muted-foreground sm:px-6">
          {titleA}
        </div>
        <ul class="divide-y divide-border" role="list">
          {itemsA.map((item) => (
            <li class="px-4 py-3 text-body-sm text-muted-foreground sm:px-6">{item}</li>
          ))}
        </ul>
      </div>
      <div>
        <div class="bg-muted/60 px-4 py-3 text-caption font-semibold uppercase tracking-wider text-accent sm:px-6">
          {titleB}
        </div>
        <ul class="divide-y divide-border" role="list">
          {itemsB.map((item) => (
            <li class="px-4 py-3 text-body-sm font-medium text-foreground sm:px-6">{item}</li>
          ))}
        </ul>
      </div>
    </div>
  )}
</div>
