---
// ArchitectureDiagram.astro — Reusable conceptual architecture diagram.
// Static, responsive, accessible, light/dark aware. No heavy dependencies.
import type { AstroProps } from 'astro';

interface ArchStep {
  label: string;
  detail?: string;
}

interface Props extends AstroProps {
  steps: ArchStep[];
  services?: string[];
  servicesLabel?: string;
  label?: string;
  class?: string;
}

const { steps, services = [], servicesLabel, label, class: className = '' } = Astro.props;
---

<div class={`not-prose my-8 ${className}`} role="group" aria-label={label ?? 'Architecture diagram'}>
  <ol class="space-y-0" aria-label={label ?? 'Architecture layers'}>
    {steps.map((step, i) => (
      <li>
        <div class="rounded-xl border border-border bg-card px-4 py-3">
          <span class="block text-body-sm font-medium text-foreground">{step.label}</span>
          {step.detail && (
            <span class="mt-0.5 block text-caption text-muted-foreground">{step.detail}</span>
          )}
        </div>
        {i < steps.length - 1 && (
          <div class="flex justify-center py-1" aria-hidden="true">
            <svg class="h-5 w-4 text-border" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m0 0l-5-5m5 5l5-5" />
            </svg>
          </div>
        )}
      </li>
    ))}
  </ol>

  {services.length > 0 && (
    <div class="mt-3">
      <div class="mb-2 flex justify-center" aria-hidden="true">
        <svg class="h-5 w-4 text-border" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m0 0l-5-5m5 5l5-5" />
        </svg>
      </div>
      {servicesLabel && (
        <p class="mb-2 text-caption font-medium uppercase tracking-wider text-muted-foreground">
          {servicesLabel}
        </p>
      )}
      <ul class="flex flex-wrap gap-2" role="list">
        {services.map((service) => (
          <li class="rounded-lg border border-border bg-muted/60 px-3 py-1.5 text-body-sm text-foreground">
            {service}
          </li>
        ))}
      </ul>
    </div>
  )}
</div>
