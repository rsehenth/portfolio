---
interface Props {
  locale?: 'pt-BR' | 'en';
  stage: string;
  evidence: string;
  nextValidation?: string;
}

const { locale = 'pt-BR', stage, evidence, nextValidation } = Astro.props;
const labels = locale === 'pt-BR'
  ? ['Estágio', 'O que existe ou foi validado', 'Próxima validação']
  : ['Stage', 'What exists or has been validated', 'Next validation'];
const items = [
  { label: labels[0], value: stage },
  { label: labels[1], value: evidence },
  ...(nextValidation ? [{ label: labels[2], value: nextValidation }] : []),
];
---

<section class="mb-10 rounded-2xl border border-border bg-muted/40 p-6 lg:p-8" aria-labelledby="status-evidence-heading" data-reveal="scale">
  <h2 id="status-evidence-heading" class="mb-5 text-caption font-semibold uppercase tracking-widest text-muted-foreground">
    {locale === 'pt-BR' ? 'Status e evidências' : 'Status and evidence'}
  </h2>
  <dl class="grid gap-5">
    {items.map(({ label, value }) => (
      <div>
        <dt class="text-caption font-semibold uppercase tracking-wider text-muted-foreground">{label}</dt>
        <dd class="mt-1 text-body-md leading-relaxed text-foreground">{value}</dd>
      </div>
    ))}
  </dl>
</section>
