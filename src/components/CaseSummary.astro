---
interface Props {
  locale?: 'pt-BR' | 'en';
  problem: string;
  role: string;
  result: string;
  keyDecision: string;
}

const { locale = 'pt-BR', problem, role, result, keyDecision } = Astro.props;
const labels = locale === 'pt-BR'
  ? ['Problema', 'Meu papel', 'Resultado', 'Decisão-chave']
  : ['Problem', 'My role', 'Result', 'Key decision'];
const items = [problem, role, result, keyDecision];
---

<section class="case-brief" aria-labelledby="case-summary-heading" data-reveal>
  <h2 id="case-summary-heading" class="case-brief__title">
    {locale === 'pt-BR' ? 'Resumo' : 'Summary'}
  </h2>
  <dl class="case-brief__grid">
    {items.map((value, index) => (
      <div>
        <dt>{labels[index]}</dt>
        <dd>{value}</dd>
      </div>
    ))}
  </dl>
</section>
