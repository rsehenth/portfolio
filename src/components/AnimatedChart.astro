---
// AnimatedChart.astro - Reusable Chart.js component with accessibility
import type { AstroProps } from 'astro';

interface Props extends AstroProps {
  type: 'bar' | 'line' | 'doughnut';
  title: string;
  labels: string[];
  values: number[];
  datasetLabel?: string;
  suffix?: string;
  prefix?: string;
  colors?: string[];
  height?: number;
  class?: string;
  // Accessibility
  description?: string;
}

const {
  type,
  title,
  labels,
  values,
  datasetLabel = 'Value',
  suffix = '',
  prefix = '',
  colors,
  height = 300,
  class: className = '',
  description,
} = Astro.props;

const chartId = `chart-${Math.random().toString(36).substr(2, 9)}`;

// Custom colors remain available, otherwise the browser resolves the active theme accent.
const chartColors = colors?.length ? colors : [];

// Generate accessible data table for screen readers
const generateDataTable = () => {
  let html = '<table class="w-full border-collapse" aria-hidden="true"><thead><tr>';
  html += '<th scope="col" class="px-4 py-2 text-left text-caption font-semibold text-muted-foreground">Category</th>';
  html += `<th scope="col" class="px-4 py-2 text-left text-caption font-semibold text-muted-foreground">${datasetLabel}</th>`;
  html += '</tr></thead><tbody>';
  labels.forEach((label, i) => {
    html += `<tr class="border-t border-border"><td class="px-4 py-2 text-body-sm">${label}</td>`;
    html += `<td class="px-4 py-2 text-body-sm font-medium">${prefix}${values[i]}${suffix}</td></tr>`;
  });
  html += '</tbody></table>';
  return html;
};

// Prepare data for script (serialize to JSON strings)
const labelsJson = JSON.stringify(labels);
const valuesJson = JSON.stringify(values);
const colorsJson = JSON.stringify(chartColors);
const datasetLabelJson = JSON.stringify(datasetLabel);
const prefixJson = JSON.stringify(prefix);
const suffixJson = JSON.stringify(suffix);
---

<div class={`card p-6 ${className}`} style={`--chart-height: ${height}px;`}>
  <div class="mb-4">
    <h3 class="text-heading-sm font-semibold text-foreground mb-1">{title}</h3>
    {description && <p class="text-body-sm text-muted-foreground">{description}</p>}
  </div>

  <!-- Chart canvas -->
  <div class="relative" style={`height: ${height}px; width: 100%;`}>
    <canvas
      id={chartId}
      aria-label={title}
      role="img"
      aria-describedby={`${chartId}-desc`}
      data-type={type}
      data-labels={labelsJson}
      data-values={valuesJson}
      data-colors={colorsJson}
      data-dataset-label={datasetLabelJson}
      data-prefix={prefixJson}
      data-suffix={suffixJson}
    />
    <div id={`${chartId}-desc`} class="sr-only">
      {description || `Chart showing ${datasetLabel} across ${labels.length} categories. ${labels.map((l, i) => `${l}: ${prefix}${values[i]}${suffix}`).join(', ')}`}
    </div>
  </div>

  <!-- Accessible data table (visually hidden but available to screen readers) -->
  <div class="sr-only" aria-live="polite">
    {generateDataTable()}
  </div>

  <!-- Visible data table toggle for accessibility -->
  <details class="mt-4" aria-label="View data table">
    <summary class="btn-ghost text-body-sm">
      View data table
      <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    <div class="mt-4 overflow-x-auto">
      {generateDataTable()}
    </div>
  </details>
</div>

<script>
import Chart from 'chart.js/auto';

const themeToken = (name) => `rgb(${getComputedStyle(document.documentElement).getPropertyValue(name).trim()})`;

const accentPalette = (customColors) => customColors.length ? customColors : [
  themeToken('--color-accent-rgb'),
  `rgb(${getComputedStyle(document.documentElement).getPropertyValue('--color-accent-rgb').trim()} / 0.7)`,
  `rgb(${getComputedStyle(document.documentElement).getPropertyValue('--color-accent-rgb').trim()} / 0.5)`,
  `rgb(${getComputedStyle(document.documentElement).getPropertyValue('--color-accent-rgb').trim()} / 0.3)`,
];

const applyThemeColors = (chart, canvas) => {
  const customColors = JSON.parse(canvas.dataset.colors || '[]');
  const colors = accentPalette(customColors);
  const dataset = chart.data.datasets[0];

  dataset.backgroundColor = colors;
  dataset.borderColor = colors;

  if (canvas.dataset.type === 'line') {
    dataset.pointBackgroundColor = colors[0];
    dataset.pointBorderColor = themeToken('--color-card-rgb');
  }

  const tooltip = chart.options.plugins.tooltip;
  tooltip.backgroundColor = themeToken('--color-card-rgb');
  tooltip.titleColor = themeToken('--color-foreground-rgb');
  tooltip.bodyColor = themeToken('--color-muted-foreground-rgb');
  tooltip.borderColor = themeToken('--color-border-rgb');

  if (canvas.dataset.type !== 'doughnut') {
    chart.options.scales.x.ticks.color = themeToken('--color-muted-foreground-rgb');
    chart.options.scales.y.grid.color = themeToken('--color-border-rgb');
    chart.options.scales.y.ticks.color = themeToken('--color-muted-foreground-rgb');
  }
};

const charts = [];

document.querySelectorAll('canvas[data-type]').forEach((canvas) => {
  if (Chart.getChart(canvas)) return;

  const context = canvas.getContext('2d');
  if (!context) return;

  const type = canvas.dataset.type;
  const labels = JSON.parse(canvas.dataset.labels || '[]');
  const values = JSON.parse(canvas.dataset.values || '[]');
  const customColors = JSON.parse(canvas.dataset.colors || '[]');
  const datasetLabel = canvas.dataset.datasetLabel || 'Value';
  const prefix = canvas.dataset.prefix || '';
  const suffix = canvas.dataset.suffix || '';
  const colors = accentPalette(customColors);
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const dataset = {
    label: datasetLabel,
    data: values,
    backgroundColor: colors,
    borderColor: colors,
    borderWidth: 2,
    borderRadius: 6,
    borderSkipped: false,
  };

  if (type === 'line') {
    dataset.fill = false;
    dataset.tension = 0.3;
    dataset.pointBackgroundColor = colors[0];
    dataset.pointBorderColor = themeToken('--color-card-rgb');
    dataset.pointBorderWidth = 2;
    dataset.pointRadius = 5;
    dataset.pointHoverRadius = 7;
  }

  if (type === 'doughnut') {
    dataset.cutout = '65%';
    dataset.borderWidth = 0;
  }

  const chart = new Chart(context, {
    type,
    data: { labels, datasets: [dataset] },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: reducedMotion ? false : { duration: 1000, easing: 'easeOutQuart' },
      interaction: { intersect: false, mode: 'index' },
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: themeToken('--color-card-rgb'),
          titleColor: themeToken('--color-foreground-rgb'),
          bodyColor: themeToken('--color-muted-foreground-rgb'),
          borderColor: themeToken('--color-border-rgb'),
          borderWidth: 1,
          padding: 12,
          displayColors: false,
          callbacks: {
            label: (context) => `${prefix}${context.parsed.y}${suffix}`,
          },
        },
      },
      scales: type !== 'doughnut' ? {
        x: {
          grid: { display: false },
          ticks: { color: themeToken('--color-muted-foreground-rgb'), font: { size: 12 } },
        },
        y: {
          grid: { color: themeToken('--color-border-rgb') },
          ticks: {
            color: themeToken('--color-muted-foreground-rgb'),
            font: { size: 12 },
            callback: (value) => `${prefix}${value}${suffix}`,
          },
          beginAtZero: true,
        },
      } : {},
    },
  });

  charts.push({ chart, canvas });
});

document.addEventListener('portfolio:themechange', () => {
  charts.forEach(({ chart, canvas }) => {
    applyThemeColors(chart, canvas);
    chart.update('none');
  });
});
</script>
