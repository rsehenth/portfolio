---
// ProjectCard.astro - Project card used by the /projects listing (PT + EN).
// Case pages never render this component (only the MDX registry exposes it),
// so every field below marked "listing-only" stays out of the case studies.
import { ui, statusLabel, type Locale } from '@/i18n';
import ProjectPlate from '@/components/ProjectPlate.astro';
import { badgeToneOf, caseUrl, projectKey, verifiedOnly, type ProjectEntry } from '@/lib/projects';

interface Props {
  project: ProjectEntry;
  variant?: 'default' | 'featured' | 'compact' | 'wide';
  /** Wide rows only: put the image on the right. */
  reverse?: boolean;
  class?: string;
  locale?: Locale;
  /** Heading level for the card title (2 under a page h1, 3 under a section h2) */
  headingLevel?: 2 | 3;
}

const { project, variant = 'default', reverse = false, class: className = '', locale = 'pt-BR', headingLevel = 3 } = Astro.props;
const { data } = project;
const {
  title,
  subtitle,
  description,
  year,
  status,
  statusBadge,
  cardBadge,
  cardHighlights,
  cover,
  metrics,
  demonstrates,
} = data;
const work = ui[locale].work;

const key = projectKey(project);
const href = caseUrl(locale, key);
const noCase = data.noCase ?? false;
const isCompact = variant === 'compact';
const TitleTag = headingLevel === 2 ? 'h2' : 'h3';

// Status: text colour by tone, never colour alone. Falls back to the
// frontmatter badge / localized status when a project has no listing badge.
const badgeLabel = cardBadge?.label ?? statusBadge ?? statusLabel(locale, status);
const badgeTone = badgeToneOf(data);

// Metrics: max 3 numeric/short values in ONE row.
// `display: 'text'` values are words — they go to the highlights line instead,
// so they never render with the big-number treatment.
const cardMetrics = verifiedOnly(metrics).filter((metric) => metric.display !== 'text').slice(0, 3);
const highlights = cardHighlights ?? [];
const demonstratesItems = demonstrates.slice(0, 3);

const ctaLabel = work.viewCase.replace(/\s*→\s*$/, '');
---

<article
  class:list={[
    'project-card',
    `project-card--${variant}`,
    reverse && 'project-card--reverse',
    noCase && 'project-card--disabled',
    className,
  ]}
  aria-labelledby={`project-${key}-title`}
>
  {
    isCompact ? (
      <div class="project-card__row">
        <div class="project-card__thumb">
          {cover ? (
            <img src={cover} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
          ) : (
            <ProjectPlate projectKey={key} title={title} tone={badgeTone} />
          )}
        </div>
        <div class="project-card__row-main">
          <TitleTag id={`project-${key}-title`} class="project-card__title project-card__title--compact">
            {noCase ? (
              <span>{title}</span>
            ) : (
              <a class="project-card__link" href={href}>
                {title}
              </a>
            )}
          </TitleTag>
          <p class="project-card__description project-card__description--compact">{description}</p>
        </div>
        <p class="project-card__meta">
          <span class="project-card__badge" data-tone={badgeTone}>{badgeLabel}</span>
          <time datetime={year.toString()}>{year}</time>
        </p>
      </div>
    ) : (
      <>
        <div class="project-card__media" aria-hidden="true">
          {cover ? (
            <img src={cover} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
          ) : (
            <ProjectPlate projectKey={key} title={title} tone={badgeTone} />
          )}
        </div>

        <div class="project-card__body">
          <p class="project-card__meta">
            <span class="project-card__badge" data-tone={badgeTone}>{badgeLabel}</span>
            <time datetime={year.toString()}>{year}</time>
          </p>

          <TitleTag id={`project-${key}-title`} class="project-card__title">
            {noCase ? (
              <span>{title}</span>
            ) : (
              <a class="project-card__link" href={href}>
                {title}
              </a>
            )}
          </TitleTag>

          {subtitle && <p class="project-card__subtitle">{subtitle}</p>}

          <p class="project-card__description">{description}</p>

          {cardMetrics.length > 0 && (
            <dl class="project-card__metrics">
              {cardMetrics.map((metric) => (
                <div>
                  <dt>{metric.value}</dt>
                  <dd>{metric.label}</dd>
                </div>
              ))}
            </dl>
          )}

          {highlights.length > 0 && <p class="project-card__line">{highlights.join(' · ')}</p>}

          {highlights.length === 0 && demonstratesItems.length > 0 && (
            <p class="project-card__line project-card__line--soft">{demonstratesItems.join(' · ')}</p>
          )}

          <div class="project-card__cta-row">
            {noCase ? (
              <span class="project-card__cta project-card__cta--disabled" aria-disabled="true">
                {work.caseSoon}
              </span>
            ) : (
              <span class="project-card__cta">
                {ctaLabel}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            )}
          </div>
        </div>
      </>
    )
  }
</article>

<style>
  .project-card {
    position: relative; /* anchors the stretched title link */
    display: flex;
    flex-direction: column;
    height: 100%;
    background: transparent;
  }

  /* One stretched link makes the whole card clickable, with one tab stop. */
  .project-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .project-card__link { color: inherit; text-decoration: none; }
  .project-card__link:focus-visible { outline: none; }
  .project-card:has(.project-card__link:focus-visible) {
    outline: 2px solid rgb(var(--color-accent-rgb));
    outline-offset: 6px;
  }

  /* ── Media: every card gets a 16:10 slot, real cover or a quiet tile ── */
  .project-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: rgb(var(--color-muted-rgb));
  }

  .project-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .project-card:hover .project-card__media img {
      transform: scale(1.03);
    }
  }

  /* ── Body ──────────────────────────────────────────────────────── */
  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 0 0;
  }

  .project-card__meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.3;
    color: rgb(var(--color-muted-foreground-rgb));
  }

  .project-card__meta time {
    font-variant-numeric: tabular-nums;
  }

  .project-card__badge {
    font-weight: 700;
    color: var(--tone, rgb(var(--color-muted-foreground-rgb)));
  }

  .project-card__badge[data-tone='active'] { --tone: var(--tone-active); }
  .project-card__badge[data-tone='development'] { --tone: var(--tone-development); }
  .project-card__badge[data-tone='functional'] { --tone: var(--tone-functional); }
  .project-card__badge[data-tone='discovery'] { --tone: var(--tone-discovery); }
  .project-card__badge[data-tone='archived'] { --tone: var(--tone-archived); }

  .project-card__title {
    margin: 0;
    font-size: clamp(1.625rem, 2.2vw, 2.125rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: rgb(var(--color-foreground-rgb));
  }

  .project-card--featured .project-card__title {
    font-size: clamp(2rem, 3.2vw, 3rem);
    letter-spacing: -0.035em;
  }

  .project-card__title--compact {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .project-card__subtitle {
    margin: -0.25rem 0 0;
    font-size: 0.9375rem;
    color: rgb(var(--color-muted-foreground-rgb));
  }

  .project-card__description {
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 0.82);
  }

  .project-card--featured .project-card__description {
    -webkit-line-clamp: 4;
    font-size: 1.0625rem;
  }

  .project-card__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.25rem;
    margin: 0.5rem 0 0;
  }

  .project-card__metrics dt {
    font-size: clamp(1.75rem, 2.4vw, 2.25rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: rgb(var(--color-foreground-rgb));
  }

  .project-card__metrics dd {
    margin: 0.375rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: rgb(var(--color-muted-foreground-rgb));
  }

  .project-card__line {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgb(var(--color-muted-foreground-rgb));
  }

  .project-card__line--soft { opacity: 0.9; }

  .project-card__cta-row {
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .project-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: rgb(var(--color-accent-rgb));
  }

  .project-card__cta svg {
    width: 1rem;
    height: 1rem;
    transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .project-card:hover .project-card__cta svg { transform: translateX(4px); }
  }

  .project-card__cta--disabled { color: rgb(var(--color-muted-foreground-rgb)); font-weight: 500; }

  .project-card--disabled .project-card__media img { transform: none; }

  /* ── Compact row (archived) ────────────────────────────────────── */
  .project-card__row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-block: 1.25rem;
  }

  .project-card__thumb {
    flex: none;
    width: 6.5rem;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .project-card__thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .project-card__row-main { min-width: 0; }

  .project-card__description--compact {
    margin-top: 0.375rem;
    -webkit-line-clamp: 2;
    font-size: 0.9375rem;
  }

  @media (min-width: 768px) {
    .project-card__row {
      flex-direction: row;
      align-items: center;
      gap: 1.75rem;
    }
    .project-card__row-main { flex: 1; }
    .project-card__row .project-card__meta { flex: none; }
    .project-card__thumb { width: 8rem; }
  }

  /* ── Wide: a section with a single project, image beside text ──── */
  @media (min-width: 900px) {
    .project-card--wide {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: center;
    }
    .project-card--reverse { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .project-card--reverse .project-card__media { order: 2; }
    .project-card--wide .project-card__body { padding: 0; }
    .project-card--wide .project-card__title { font-size: clamp(2rem, 3.2vw, 3rem); letter-spacing: -0.035em; }
    .project-card--wide .project-card__description { -webkit-line-clamp: 5; font-size: 1.0625rem; }
  }
</style>
