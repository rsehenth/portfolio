---
// RoleBlocks.astro — Four-block role breakdown for case studies
// (Product / AI Product / Technical Product / Hands-on Execution).
interface RoleBlock {
  title: string;
  items: string[];
}

interface Props {
  blocks: RoleBlock[];
  label?: string;
  class?: string;
}

const { blocks, label, class: className = '' } = Astro.props;
---

<div
  class={`not-prose my-8 grid gap-4 sm:grid-cols-2 ${className}`}
  role="group"
  aria-label={label ?? 'Role breakdown'}
>
  {blocks.map((block) => (
    <section class="card p-5">
      <h3 class="mb-3 text-caption font-semibold uppercase tracking-wider text-accent">
        {block.title}
      </h3>
      <ul class="space-y-1.5" role="list">
        {block.items.map((item) => (
          <li class="flex items-start gap-2 text-body-sm text-muted-foreground">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
