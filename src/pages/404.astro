---
// 404.astro - Not found page (Portuguese)
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profile } from '@/data/profile';
import { ui } from '@/i18n';
---

<BaseLayout
  title="Página Não Encontrada"
  description="A página que você procura não existe."
  noIndex={true}
  locale="pt-BR"
>
  <section class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="text-center max-w-md">
      <h1 class="text-display-xl font-bold tracking-tight text-foreground mb-4">404</h1>
      <h2 class="text-display-sm font-semibold text-foreground mb-4">Página Não Encontrada</h2>
      <p class="text-body-lg text-muted-foreground mb-8">
        Desculpe, a página que você procura não existe ou foi movida.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="btn-primary">
          Voltar ao Início
        </a>
        <a href="/projects/" class="btn-secondary">
          Ver Projetos
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
