---
// about.astro - About page (PT-BR)
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profile } from '@/data/profile';
import { ui } from '@/i18n';
import EmailReveal from '@/components/EmailReveal.astro';

const about = ui['pt-BR'].about;
const contact = ui['pt-BR'].contact;
const productDecision = about.productDecision;
const hasProductDecision = Boolean(productDecision.context || productDecision.decision || productDecision.result);
---

<BaseLayout
  class="proof-page proof-page--about"
  title={about.meta.title}
  fullTitle={about.meta.title}
  description={about.meta.description}
  locale="pt-BR"
>
  <section class="section pt-20 lg:pt-32" aria-labelledby="about-heading">
    <div class="container">

      <!-- Hero -->
      <header class="about-heading mb-10 lg:mb-20" data-reveal>
        <h1 id="about-heading" class="text-display-lg lg:text-display-lg font-bold tracking-tight text-foreground mb-4 lg:mb-6">
          {about.title}
        </h1>
        <p class="text-body-lg text-muted-foreground">
          {about.heroTagline}
        </p>
      </header>

      <!-- Introdução -->
      <div class="about-reading mb-10 lg:mb-20" data-reveal>
        <h2 class="about-subheading text-heading-md font-semibold text-foreground mb-3 lg:mb-4">{about.intro.productPathTitle}</h2>
        <p class="text-body-lg text-muted-foreground mb-5 lg:mb-6">
          {about.intro.p1}
        </p>
        <p class="text-body-md text-muted-foreground mb-5 lg:mb-6">
          {about.intro.p2}
        </p>
        <h2 class="about-subheading text-heading-md font-semibold text-foreground mb-3 lg:mb-4">{about.intro.todayTitle}</h2>
        <p class="text-body-md text-muted-foreground mb-5 lg:mb-6">
          {about.intro.p3}
        </p>
        <p class="text-body-md text-muted-foreground mb-5 lg:mb-6">
          {about.intro.p4}
        </p>
        <p class="text-body-md text-muted-foreground mb-5 lg:mb-6">
          {about.intro.p5}
        </p>
        <p class="text-body-sm text-muted-foreground">{about.transparency}</p>
        <div class="about-inline-actions mt-6 flex flex-col sm:flex-row gap-3" aria-label="Próximos passos">
          <a href="/projects/" class="btn-primary w-full sm:w-auto">{about.ctaProjects}</a>
          <a href={profile.linkedin} class="btn-secondary w-full sm:w-auto" target="_blank" rel="noopener noreferrer">{about.ctaLinkedin}</a>
        </div>
      </div>

      {hasProductDecision && (
        <section class="about-reading mb-10 lg:mb-20" aria-labelledby="decision-heading" data-reveal>
          <h2 id="decision-heading" class="text-display-sm font-bold tracking-tight text-foreground mb-6">{productDecision.title}</h2>
          <dl class="about-decision border-t border-border" data-ui>
            {productDecision.context && <div><dt>{productDecision.contextLabel}</dt><dd>{productDecision.context}</dd></div>}
            {productDecision.decision && <div><dt>{productDecision.decisionLabel}</dt><dd>{productDecision.decision}</dd></div>}
            {productDecision.result && <div><dt>{productDecision.resultLabel}</dt><dd>{productDecision.result}</dd></div>}
          </dl>
        </section>
      )}

      <section class="about-reading mb-10 lg:mb-20" aria-labelledby="timeline-heading" data-reveal>
        <h2 id="timeline-heading" class="text-display-sm lg:text-display-md font-bold tracking-tight text-foreground mb-6 lg:mb-8">{about.timeline.title}</h2>
        {about.timeline.showOverlapNote && <p class="text-body-sm text-muted-foreground mb-5">{about.timeline.overlapNote}</p>}
        <ol class="border-l border-border pl-5 lg:pl-6 space-y-6 lg:space-y-8" data-ui>
          {about.timeline.items.map((item) => (
            <li class="relative">
              <span class="absolute -left-[29px] lg:-left-[31px] top-1.5 h-3 w-3 rounded-full border-2 border-background bg-accent" aria-hidden="true"></span>
              <p class="text-caption font-mono text-muted-foreground">{item.period}</p><!-- taste-skill-ignore: timeline period is a compact data label. -->
              <h3 class="mt-1 text-heading-sm lg:text-heading-md font-semibold text-foreground">{item.company}</h3>
              <p class="mt-1 text-body-sm font-medium text-foreground">{item.role}</p>
              <p class="mt-1 text-body-sm text-muted-foreground">{item.description}</p>
              {item.highlight && <p class="mt-3 text-body-sm font-medium text-foreground">{item.highlight}</p>}
            </li>
          ))}
        </ol>
      </section>

      <!-- Onde Atuo -->
      <section class="about-wide mb-10 lg:mb-20" aria-labelledby="focus-heading">
        <h2 id="focus-heading" class="text-display-sm lg:text-display-md font-bold tracking-tight text-foreground mb-6 lg:mb-10" data-reveal>
          {about.focus.title}
        </h2>
        <div class="grid sm:grid-cols-2 gap-4 lg:gap-6">
          <div class="card p-5 lg:p-6" data-reveal data-reveal-delay="0">
            <h3 class="text-heading-sm lg:text-heading-md font-semibold text-foreground mb-2 lg:mb-3">{about.focus.productStrategy.title}</h3>
            <p class="text-body-sm lg:text-body-md text-muted-foreground">{about.focus.productStrategy.description}</p>
          </div>
          <div class="card p-5 lg:p-6" data-reveal data-reveal-delay="80">
            <h3 class="text-heading-sm lg:text-heading-md font-semibold text-foreground mb-2 lg:mb-3">{about.focus.aiProducts.title}</h3>
            <p class="text-body-sm lg:text-body-md text-muted-foreground">{about.focus.aiProducts.description}</p>
          </div>
          <div class="card p-5 lg:p-6" data-reveal data-reveal-delay="160">
            <h3 class="text-heading-sm lg:text-heading-md font-semibold text-foreground mb-2 lg:mb-3">{about.focus.technicalProduct.title}</h3>
            <p class="text-body-sm lg:text-body-md text-muted-foreground">{about.focus.technicalProduct.description}</p>
          </div>
          <div class="card p-5 lg:p-6" data-reveal data-reveal-delay="240">
            <h3 class="text-heading-sm lg:text-heading-md font-semibold text-foreground mb-2 lg:mb-3">{about.focus.experimentation.title}</h3>
            <p class="text-body-sm lg:text-body-md text-muted-foreground">{about.focus.experimentation.description}</p>
          </div>
        </div>
      </section>

      <!-- Ferramentas Técnicas -->
      <section class="about-wide mb-10 lg:mb-20" aria-labelledby="toolkit-heading" data-reveal>
        <h2 id="toolkit-heading" class="text-display-sm font-bold tracking-tight text-foreground mb-6 lg:mb-8">
          {about.toolkit.title}
        </h2>
        <div class="grid sm:grid-cols-3 gap-3 lg:gap-4">
          {about.toolkit.groups.map((group) => (
            <div class="card p-4 lg:p-5">
              <h3 class="text-heading-sm font-semibold text-foreground mb-3">{group.category}</h3>
              <div class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="tag">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <div class="about-contact pb-8 lg:pb-0" data-reveal="scale">
        <div class="card p-6 lg:p-12 text-left">
          <h2 class="text-display-sm font-bold tracking-tight text-foreground mb-3 lg:mb-4">
            {contact.title}
          </h2>
          <p class="text-body-md text-muted-foreground mb-6 lg:mb-8">
            {contact.subtitle}
          </p>
          <div class="flex flex-col sm:flex-row items-start justify-start gap-3 lg:gap-4 flex-wrap">
            <a href={profile.linkedin} class="btn-primary w-full sm:w-auto" target="_blank" rel="noopener noreferrer">
              {contact.ctaLinkedin}
            </a>
            <EmailReveal
              locale="pt-BR"
              buttonLabel={contact.showEmail}
              revealedLabel={contact.emailRevealedLabel}
              ariaLabel={contact.emailAriaLabel}
            />
            <a
              href="/lucas-cvpt.pdf"
              download
              aria-label="Baixar currículo em PDF"
              class="btn-secondary inline-flex items-center justify-center gap-2 w-full sm:w-auto"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              {contact.ctaCV}
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
